---
import ContactForm from '../components/ContactForm.astro';
import CollectionGlyph from '../components/CollectionGlyph.astro';
import WorkCard from '../components/WorkCard.astro';
import Base from '../layouts/Base.astro';
import { socialLinks } from '../config/profile';
import activity from '../data/activity.json';
import { collections } from '../data/collections';
import { combineRepositories } from '../lib/repositories.mjs';

const repositories = combineRepositories(activity.items);
const featuredRepo = repositories.find(repo => repo.links.some(link => link.url === 'https://github.com/jacobhroutzong/coding-challenges'));
type Repository = (typeof repositories)[number];
const recentRepos: Repository[] = [...(featuredRepo ? [featuredRepo] : []), ...repositories.filter(repo => repo !== featuredRepo).slice(0, 5)];
const date = (value: string | null) => value ? new Date(value).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : null;
const memberTotal = (c: (typeof collections)[number]) => c.suites.reduce((n, s) => n + s.members.length, 0);
---
<Base title="Engineering portfolio" description="Jacob Routzong’s applications in machine learning, decision systems, and scientific computing, grouped by what they help you do.">
  <div class="container">
    <section class="home-hero" aria-labelledby="home-title">
      <div>
        <p class="kicker reveal" style="--i:0">Jacob Routzong</p>
        <h1 id="home-title" class="reveal" style="--i:1">Software you can <em>run</em>: models, decisions, and mathematics.</h1>
        <p class="home-hero__lede reveal" style="--i:2">I’m an engineer working across machine learning, data, and scientific computing. These are the applications I’ve built, grouped by what they help you do.</p>
        <div class="cta-row reveal" style="--i:3">
          <a class="button primary" href="/projects/">Browse the work</a>
          <a class="button secondary" href="#contact">Get in touch</a>
        </div>
        <div class="profile-links reveal" style="--i:4">{socialLinks.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>
      </div>

      <div class="collection-index reveal" style="--i:3" role="navigation" aria-label="Collections">
        <div class="collection-index__head"><span>Collections</span><span>{collections.length}</span></div>
        <ol>
          {collections.map(c => (
            <li data-collection={c.id}>
              <a href={`#${c.id}`}>
                <span class="idx">{c.number}</span>
                <span class="ttl">{c.title}</span>
                <span class="cnt">{memberTotal(c)} {memberTotal(c) === 1 ? 'app' : 'apps'}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="work" class="home-work" aria-labelledby="work-title">
      <div class="section-head">
        <h2 id="work-title">Work</h2>
        <a class="arrow-link" href="/projects/">Full details <span aria-hidden="true">→</span></a>
      </div>
      {collections.map(c => (
        <article id={c.id} class="collection-row" data-collection={c.id}>
          <header class="collection-row__head">
            <span class="collection-row__num">{c.number}</span>
            <h3>{c.title}</h3>
            <p class="collection-row__blurb">{c.blurb}</p>
            {c.overview && <a class="arrow-link" href={c.overview.href}>{c.overview.label} <span aria-hidden="true">→</span></a>}
            <CollectionGlyph kind={c.glyph} />
          </header>
          <div class="collection-row__cards">
            {c.suites.map(suite => <WorkCard suite={suite} variant="compact" />)}
          </div>
        </article>
      ))}
    </section>

    <section id="activity" class="home-activity" aria-labelledby="activity-title">
      <div class="section-head">
        <h2 id="activity-title">Recent activity</h2>
        <a class="arrow-link" href="/activity/">All repositories <span aria-hidden="true">→</span></a>
      </div>
      <ul class="activity-list">
        {recentRepos.map(repo => (
          <li>
            <span class="activity-list__name">
              <a href={repo.url} target="_blank" rel="noopener noreferrer">{repo.name} ↗</a>
              {repo === featuredRepo && <span class="activity-list__flag">Featured</span>}
            </span>
            <p class="activity-list__desc">{repo.description || 'Source code and documentation.'}</p>
            <span class="activity-list__meta">
              <span>{repo.links.map(link => link.platform).filter((platform, index, list) => list.indexOf(platform) === index).join(' + ')}</span><br />
              <span>{repo.updated ? `${repo.githubUpdated ? 'Pushed' : 'Updated'} ${date(repo.githubUpdated || repo.updated)}` : 'Date unavailable'}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section id="contact" class="home-contact"><ContactForm /></section>
  </div>
</Base>
