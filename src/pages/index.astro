---
import ContactForm from '../components/ContactForm.astro';
import Base from '../layouts/Base.astro';
import { profile, socialLinks } from '../config/profile';
import activity from '../data/activity.json';
import { combineRepositories } from '../lib/repositories.mjs';
import { selectedProjects } from '../data/selected-projects';
const newestProjects = selectedProjects.toReversed();
const recentProjects = newestProjects.slice(0,3);
const olderProjects = newestProjects.slice(3);
const repositories = combineRepositories(activity.items);
const featuredRepo = repositories.find(repo => repo.links.some(link => link.url === 'https://github.com/jacobhroutzong/coding-challenges'));
const repos = repositories.filter(repo => repo !== featuredRepo);
const date = (value: string | null) => value ? new Date(value).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'}) : null;
---
<Base title="About me" description="Jacob Routzong’s work in AI, data, and engineering. Explore recent repositories, interactive projects, and public profiles."><div class="container personal-home">
<section id="about" class="introduction"><div class="eyebrow">ABOUT ME</div><h1>{profile.name}</h1><p class="lead">I’m building projects in AI, data, and engineering, with a focus on turning ideas in code into applications you can explore.</p><p>This site brings that work together. My recent repositories show what I’m working on, while the Work section collects projects with their own walkthroughs and interactive pages.</p><div class="intro-links">{socialLinks.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}<a href="/projects/">Explore my work →</a></div></section>
<nav class="home-index" aria-label="On this page"><span>ON THIS PAGE</span><a href="#projects">My work ↓</a><a href="#repositories">Repositories ↓</a><a href="#contact">Contact ↓</a></nav>
<section id="projects" class="home-section"><div class="section-heading"><div><div class="eyebrow">FROM THE PORTFOLIO</div><h2>My work.</h2></div><a class="text-link" href="/projects/">All work ↗</a></div>{recentProjects.map(project => <article class="selected-project"><div><span class="eyebrow">{project.eyebrow}</span><h3>{project.title}</h3><p>{project.description}</p></div><a class="button primary" href={project.href}>{project.linkLabel}</a></article>)}{olderProjects.length > 0 && <><div id="older-selected-projects" hidden>{olderProjects.map(project => <article class="selected-project"><div><span class="eyebrow">{project.eyebrow}</span><h3>{project.title}</h3><p>{project.description}</p></div><a class="button primary" href={project.href}>{project.linkLabel}</a></article>)}</div><button id="toggle-selected-projects" class="projects-toggle" aria-expanded="false" aria-controls="older-selected-projects" data-count={olderProjects.length}><span>Show {olderProjects.length} more {olderProjects.length === 1 ? 'project' : 'projects'}</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button></>}</section>

<section id="repositories" class="home-section"><div class="section-heading"><div><div class="eyebrow">WHAT I’M WORKING ON</div><h2>Repositories.</h2></div><a class="text-link" href="/activity/">All activity ↗</a></div>{featuredRepo && <article class="featured-repository"><div class="eyebrow">FEATURED REPOSITORY</div><h3><a href={featuredRepo.url} target="_blank" rel="noopener noreferrer">Coding Challenges ↗</a></h3><p>{featuredRepo.description || 'Coding practice, original solutions, and experiments across disciplines.'}</p><div class="repo-meta"><span>{featuredRepo.language || 'GitHub'}</span><span>{featuredRepo.updated ? `Last push ${date(featuredRepo.updated)}` : 'Push date unavailable'}</span></div></article>}<p class="other-repositories">Other repositories · GitHub + Hugging Face</p><div class="repo-grid">{repos.map(repo => <article><div class="repo-meta"><span>{repo.links.map(link => link.platform).filter((platform,index,list) => list.indexOf(platform) === index).join(' + ')}{repo.kind === 'Fork' ? ' · Fork' : ''}</span><span>{repo.updated ? `${repo.githubUpdated ? 'Last push' : 'Updated'} ${date(repo.githubUpdated || repo.updated)}` : 'Date unavailable'}</span></div><h3><a href={repo.url} target="_blank" rel="noopener noreferrer">{repo.name} ↗</a></h3><p>{repo.description || 'Explore the source code and documentation.'}</p><div class="repository-links">{repo.links.map(link => <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.platform}{link.platform === 'Hugging Face' ? ` ${link.kind}` : ''} ↗</a>)}</div></article>)}</div><p class="snapshot-note">Coding Challenges is pinned above. Matching GitHub and Hugging Face projects share a card. Sorted by GitHub push date, or Hub update date for Hub-only projects. {activity.fetchedAt && `Snapshot checked ${date(activity.fetchedAt)}.`} <a href="/activity/">View the full tracker →</a></p></section>
<section id="contact" class="home-section"><ContactForm /></section></div></Base>
<style>
.personal-home{max-width:1050px}.introduction{max-width:760px;padding:65px 0 45px}.introduction .eyebrow{margin-bottom:16px}.introduction h1{font:normal clamp(34px,4.5vw,48px)/1.15 Georgia,serif;letter-spacing:-1.5px;margin:0 0 24px}.introduction .lead{font-size:19px;line-height:1.65;margin-bottom:20px}.introduction>p:not(.lead){font-size:15px;max-width:680px}.intro-links{display:flex;flex-wrap:wrap;gap:12px 25px;margin-top:27px}.intro-links a{font-size:12px;color:var(--accent);text-decoration:underline;text-underline-offset:4px}.home-index{display:flex;position:static;gap:25px;flex-wrap:wrap;padding:18px 0;border-block:1px solid var(--border);background:transparent}.home-index span{font:9px monospace;letter-spacing:1px;color:var(--subtle);align-self:center}.home-index a{font-size:11px;padding:0}.home-section{padding:40px 0;scroll-margin-top:110px}.home-section+.home-section{border-top:1px solid var(--border)}.home-section .section-heading{margin-bottom:23px;align-items:center}.home-section .section-heading h2{font-size:28px}.repo-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.repo-grid article{padding:23px;border:1px solid var(--border);border-radius:6px}.repo-meta{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font:10px monospace}.repo-grid h3{font-size:18px;font-weight:500;line-height:1.4;margin:17px 0 10px;overflow-wrap:anywhere}.repo-grid h3 a:hover{color:var(--accent)}.repo-grid p{font-size:13px;margin:0}.snapshot-note{font-size:10px;margin:16px 0 0}.snapshot-note a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}.hub-row{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:23px;border:1px solid var(--border);border-radius:6px}.hub-row .eyebrow{font-size:9px;margin-bottom:12px}.hub-row h3{font-size:20px;overflow-wrap:anywhere;margin-bottom:10px}.hub-row p{font-size:13px;margin:0}.hub-row>span{color:var(--accent)}.selected-project{display:flex;justify-content:space-between;align-items:center;gap:30px;padding:28px;background:var(--bg-soft);border:1px solid var(--border);border-radius:6px}.selected-project .eyebrow{font-size:9px;margin-bottom:14px}.selected-project h3{font-size:23px;margin-bottom:12px}.selected-project p{font-size:14px;max-width:570px;margin:0}.selected-project+.selected-project{margin-top:16px}.selected-project .button{flex-shrink:0}@media(max-width:760px){.introduction{padding:40px 0 30px}.introduction .lead{font-size:17px}.home-index{display:flex;overflow:visible;width:100%;gap:12px 20px;padding:18px 0}.home-index>span{flex-basis:100%}.repo-grid{grid-template-columns:1fr}.home-section .section-heading h2{font-size:25px}.home-section .section-heading>.text-link{margin-top:0;font-size:11px}.selected-project{align-items:start;flex-direction:column;padding:23px}.hub-row h3{font-size:18px}}
</style>

<script>
const projectToggle = document.querySelector<HTMLButtonElement>('#toggle-selected-projects');
const olderProjectList = document.querySelector<HTMLElement>('#older-selected-projects');
projectToggle?.addEventListener('click', () => {
 if (!olderProjectList) return;
 const expanded = projectToggle.getAttribute('aria-expanded') !== 'true';
 projectToggle.setAttribute('aria-expanded', String(expanded));
 olderProjectList.hidden = !expanded;
 const label = projectToggle.querySelector('span');
 const count = Number(projectToggle.dataset.count);
 if (label) label.textContent = expanded ? 'Show fewer projects' : `Show ${count} more ${count === 1 ? 'project' : 'projects'}`;
});
</script>
<style>
#older-selected-projects:not([hidden]){margin-top:16px}#older-selected-projects[hidden]{display:none}.projects-toggle{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;margin-top:18px;padding:12px;border:1px solid var(--border);border-radius:6px;background:transparent;color:var(--accent);font-size:12px;cursor:pointer}.projects-toggle:hover{background:var(--bg-soft)}.projects-toggle svg{transition:transform .15s}.projects-toggle[aria-expanded="true"] svg{transform:rotate(180deg)}.projects-toggle:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){.projects-toggle svg{transition:none}}
</style>

<style>.featured-repository{padding:28px;border:1px solid var(--border-strong);border-radius:7px;background:var(--bg-soft);margin-bottom:24px}.featured-repository .eyebrow{font-size:9px;margin-bottom:15px}.featured-repository h3{font-size:23px;margin-bottom:12px}.featured-repository p{font-size:14px;max-width:680px}.featured-repository .repo-meta{margin-top:20px}.other-repositories{font-size:11px;color:var(--muted);margin-bottom:14px}</style>

<style>.repository-links{display:flex;flex-wrap:wrap;gap:10px 18px;margin-top:18px}.repository-links .text-link{font-size:11px}</style>
