{"hidden":["assert solve([-1,-1])=={-1:2}","assert solve([2,1])=={2:1,1:1}","assert solve([3]*5)=={3:5}","assert len(solve(list(range(20))))==20","assert solve([0,0,0])=={0:3}","assert sum(solve([1,2,1]).values())==3","assert solve([5,6,5,6])=={5:2,6:2}","assert solve([1]*10000)=={1:10000}"],"reference":"def solve(xs):\n    counts={}\n    for x in xs: counts[x]=counts.get(x,0)+1\n    return counts"}