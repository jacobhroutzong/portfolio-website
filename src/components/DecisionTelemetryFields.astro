---
interface Field {
  id: string;
  label: string;
  unit: string;
  min: number;
  max: number;
  step: number;
  value: number;
  help: string;
}
const { fields } = Astro.props as { fields: Field[] };
---
{fields.map(field => (
  <div class="dw-field">
    <label for={field.id}>{field.label}</label>
    <div class="dw-number">
      <input id={field.id} name={field.id} type="number" inputmode={field.min < 0 ? 'text' : 'decimal'} required min={field.min} max={field.max} step={field.step} value={field.value} aria-describedby={`${field.id}-help ${field.id}-range`} />
      <span aria-hidden="true">{field.unit}</span>
    </div>
    <p id={`${field.id}-help`}>{field.help}</p>
    <span class="dw-range" id={`${field.id}-range`}>{String(field.min).replace('-', '−')} to {field.max} {field.unit} · step {field.step}</span>
  </div>
))}
