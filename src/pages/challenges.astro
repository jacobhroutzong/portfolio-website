---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../config/profile';
import index from '../data/challenges.json';
import { challengeStats, repositoryFileUrl } from '../lib/challenges.mjs';
import { categories, platforms, difficulties } from '../../scripts/metadata.mjs';
const solutions = index.solutions as {id:string;title:string;platform:string;sourceUrl:string;category:string;difficulty:string;language:string;topic:string;tags:string[];solutionPath:string;explanationPath?:string;dateSolved:string;complexity:{time:string;space:string};benchmark?:{description:string;runtimeMs:number;environment:string}}[];
const stats = challengeStats(solutions);
const repo = profile.challengeRepository || index.repositoryUrl;
const sourceRepo = index.repositoryUrl;
const topics = [...new Set(solutions.map(s => s.topic))].sort();
const tags = [...new Set(solutions.flatMap(s => s.tags))].sort();
const recent = [...solutions].sort((a,b) => b.dateSolved.localeCompare(a.dateSolved));
---
<Base title="Coding Challenges"><div class="container page-shell"><div class="eyebrow">ENGINEERING LAB / CODING CHALLENGES</div><h1 class="page-title">A record of<br /><em>deliberate practice.</em></h1><p class="page-intro">Original solutions, clear explanations, and experiments across algorithms, data, and systems. Every count comes from documented solution metadata.</p>{repo && <a class="button secondary" href={repo} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18} />Explore the coding repository<Icon name="external" size={15} /></a>}<div class="stat-grid"><div class="stat-card"><strong>{stats.total.toString().padStart(2,'0')}</strong><span>Documented solutions</span></div><div class="stat-card"><strong>{Object.keys(stats.categories).length.toString().padStart(2,'0')}</strong><span>Active categories</span></div><div class="stat-card"><strong>{stats.languages.length.toString().padStart(2,'0')}</strong><span>Languages used</span></div><div class="stat-card"><strong>{stats.platforms.length.toString().padStart(2,'0')}</strong><span>Platforms explored</span></div></div><div class="dashboard-breakdown"><section><h2>Solutions by discipline</h2><div class="breakdown-list">{categories.map(c => <span>{c} · {stats.categories[c] || 0}</span>)}</div></section><section><h2>Difficulty distribution</h2><div class="breakdown-list">{difficulties.map(d => <span>{d} · {stats.difficulty[d] || 0}</span>)}</div></section></div><form class="filter-bar challenge-filters" id="challenge-filters" role="search"><label class="search-field"><Icon name="search" size={19} /><span class="sr-only">Search challenge titles and tags</span><input name="search" type="search" placeholder="Search solutions, topics, tags…" /></label>{[
  { name:'platform',label:'Platform',values:platforms }, { name:'category',label:'Discipline',values:categories }, { name:'difficulty',label:'Difficulty',values:difficulties }, { name:'language',label:'Language',values:stats.languages }, { name:'topic',label:'Topic',values:topics }, { name:'tag',label:'Tag',values:tags },
].map(f => <label><span>{f.label}</span><select name={f.name}><option value="">All {f.name === 'difficulty' ? 'difficulties' : `${f.label.toLowerCase()}s`}</option>{f.values.map((v:string) => <option value={v}>{v}</option>)}</select></label>)}<button class="button secondary compact" type="reset">Reset filters</button></form><div class="section-heading"><h2 style="font-size:24px">Recent solutions</h2><span class="results-label" id="challenge-count" aria-live="polite">{solutions.length} solutions</span></div><div class="solution-list">{recent.map(s => <article class="solution-card" data-solution data-entry={JSON.stringify(s)}><div class="solution-meta"><span>{s.platform}</span><span>{s.difficulty}</span><span>{s.language}</span><time datetime={s.dateSolved}>{s.dateSolved}</time></div><h3>{s.title}</h3><p class="small">{s.category} · {s.topic}</p><div class="tags">{s.tags.map(t => <span>{t}</span>)}</div><p class="small" style="margin-top:15px">Time {s.complexity.time} · Space {s.complexity.space}</p>{s.benchmark && <p class="small">Measured: {s.benchmark.runtimeMs} ms — {s.benchmark.description} ({s.benchmark.environment})</p>}<div class="solution-links"><a class="text-link" href={repositoryFileUrl(sourceRepo,s.solutionPath)} target="_blank" rel="noopener noreferrer">Source code <Icon name="external" size={13} /></a>{s.explanationPath && <a class="text-link" href={repositoryFileUrl(sourceRepo,s.explanationPath)} target="_blank" rel="noopener noreferrer">Explanation <Icon name="arrow" size={14} /></a>}{s.sourceUrl && <a class="text-link" href={s.sourceUrl} target="_blank" rel="noopener noreferrer">Original problem <Icon name="external" size={13} /></a>}</div></article>)}</div><div class="empty-state" id="challenges-empty" hidden={solutions.length > 0}><Icon name="code" size={36} /><h2>{solutions.length ? 'No matching solutions.' : 'The first entry starts here.'}</h2><p>{solutions.length ? 'Adjust your filters to explore other solutions.' : 'No personal solutions have been published yet. Instructional examples are excluded from this dashboard and its statistics.'}</p></div></div><script>
  import { matchesChallenge } from '../lib/challenges.mjs';
  const form = document.querySelector<HTMLFormElement>('#challenge-filters');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-solution]')).map(card => ({card,entry:JSON.parse(card.dataset.entry || '{}')}));
  function filterChallenges() {
    if (!form) return; const values = Object.fromEntries(new FormData(form)); let count = 0;
    cards.forEach(({card,entry}) => { card.hidden = !matchesChallenge(entry,values); if (!card.hidden) count++; });
    const label = document.querySelector('#challenge-count'); if (label) label.textContent = `${count} matching solution${count === 1 ? '' : 's'}`;
    const empty = document.querySelector<HTMLElement>('#challenges-empty'); if (empty) empty.hidden = count > 0;
  }
  form?.addEventListener('input',filterChallenges); form?.addEventListener('change',filterChallenges); form?.addEventListener('submit',e => e.preventDefault()); form?.addEventListener('reset',() => setTimeout(filterChallenges,0));
</script></Base>
