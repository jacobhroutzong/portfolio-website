<section id="evaluation-lab" class="lab" aria-labelledby="evaluation-title">
  <p class="eyebrow">Evaluate · Compare · Export</p>
  <h2 id="evaluation-title">Evaluation Lab</h2>
  <p>Score saved tool-use responses against explicit expectations. Use public or synthetic data. The CPU scorer checks responses without executing tools or generating text.</p>

  <form data-evaluate method="post">
    <div class="actions">
      <button type="button" class="button secondary" data-example disabled>Load worked example</button>
      <label>Evaluation name <input name="label" value="Tool-use walkthrough" maxlength="120" required /></label>
    </div>
    <p>The worked example uses eight hand-authored cases. Edit a saved response to see which checks change.</p>
    <div data-guide class="cards"></div>
    <details>
      <summary>Advanced · JSONL cases and responses</summary>
      <label><input type="checkbox" data-advanced /> Score the advanced inputs instead of the guided example</label>
      <div class="pair">
        <label>Case JSONL file <input type="file" accept=".jsonl,.txt" data-jsonl="cases" /></label>
        <label>Response JSONL file <input type="file" accept=".jsonl,.txt" data-jsonl="predictions" /></label>
        <label>Cases (JSONL) <textarea name="cases" rows="5" spellcheck="false"></textarea></label>
        <label>Responses (JSONL) <textarea name="predictions" rows="5" spellcheck="false"></textarea></label>
      </div>
    </details>
    <button class="button primary" data-score disabled>Score responses</button>
    <p role="status" data-evaluation-status></p>
  </form>

  <section id="tunera-reports" aria-labelledby="tunera-reports-title">
    <h3 id="tunera-reports-title">Reports and comparison</h3>
    <p>Inspect case failures, export the original report JSON, or compare two reports from the same case set. Imported scores are supplied by the file.</p>
    <div class="actions">
      <label>Import Crucible report <input type="file" accept=".json,application/json" data-report-file /></label>
      <button type="button" class="button secondary" data-export disabled>Export selected report</button>
    </div>
    <p role="status" data-report-status></p>
    <div class="pair">
      <label>Selected report <select data-report aria-label="Selected report"></select></label>
      <label>Compare with <select data-compare aria-label="Compare with"></select></label>
    </div>
    <p data-comparison role="status"></p>
    <div data-metrics class="cards"></div>
    <details data-inspection hidden>
      <summary>Inspect expected and actual responses</summary>
      <label>Case <select data-inspect-case></select></label>
      <p data-failure></p>
      <div class="pair"><div><strong>Expected action</strong><pre data-expected></pre></div><div><strong>Saved response</strong><pre data-actual></pre></div></div>
    </details>
    <details>
      <summary>Research notes</summary>
      <label>Notes saved in this browser <textarea data-notes rows="4"></textarea></label>
      <button type="button" class="button secondary" data-export-notes>Export notes</button>
    </details>
    <details>
      <summary>Inspect a CLI model benchmark</summary>
      <p>Load Tunera’s <code>comparison.json</code> to view baseline and adapter measurements recorded by the CLI. Imported results come from the file.</p>
      <label>Import benchmark comparison <input type="file" accept=".json,application/json" data-benchmark-file /></label>
      <p role="status" data-benchmark-status></p>
      <div data-benchmark class="cards"></div>
    </details>
  </section>
</section>

<script>
  import { setupEvaluation } from '../scripts/tunera-evaluation.mjs';
  const lab = document.querySelector<HTMLElement>('#evaluation-lab');
  if (lab) setupEvaluation(lab);
</script>

<style is:global>
  #evaluation-lab { margin-block: 2rem 3rem; padding: clamp(1rem, 3vw, 2rem); border: 1px solid var(--border); border-radius: 10px; background: var(--bg-soft); }
  #evaluation-lab p { margin-block: .5rem; }
  #evaluation-lab label { display: grid; gap: .35rem; font-size: .9rem; }
  #evaluation-lab input:not([type=checkbox]), #evaluation-lab textarea, #evaluation-lab select, #evaluation-lab pre { width: 100%; min-width: 0; padding: .55rem; border: 1px solid var(--border-strong); border-radius: 5px; background: var(--bg); color: var(--text); }
  #evaluation-lab input[type=checkbox] { justify-self: start; }
  #evaluation-lab pre { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 18rem; overflow: auto; }
  #evaluation-lab textarea { resize: vertical; font-family: monospace; }
  #evaluation-lab form, #tunera-reports { display: grid; gap: .9rem; align-items: start; margin-top: 1rem; }
  #evaluation-lab button { justify-self: start; }
  #evaluation-lab button:disabled { opacity: .55; }
  #evaluation-lab .pair, #evaluation-lab .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; align-items: start; }
  #evaluation-lab .actions { display: flex; flex-wrap: wrap; align-items: end; gap: .8rem; }
  #evaluation-lab .card, #evaluation-lab details { padding: .8rem; border: 1px solid var(--border); border-radius: 5px; overflow-wrap: anywhere; }
  #evaluation-lab .card { background: var(--bg); }
  #evaluation-lab summary { cursor: pointer; font-weight: 600; }
  #evaluation-lab details[open] > summary { margin-bottom: .65rem; }
  #evaluation-lab [role=status]:empty { margin: 0; }
  @media (max-width: 620px) { #evaluation-lab .pair, #evaluation-lab .cards { grid-template-columns: 1fr; } }
</style>
