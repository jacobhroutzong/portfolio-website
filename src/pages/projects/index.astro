---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { visibleProjects } from '../../lib/projects';
const projects = await visibleProjects();
---
<Base title="Work"><div class="container page-shell"><div class="eyebrow">WORK / SELECTED PROJECTS</div><h1 class="page-title">Projects.</h1><p class="page-intro">Applications and project walkthroughs, each with a page of its own.</p><article class="curated-project"><div><span class="eyebrow">PYTHON · GRADIO / INTERACTIVE APPLICATION</span><h2>Decision Intelligence Engine</h2><p>An interactive control room for telemetry inputs, structured decision routing, confidence gates, and audit output.</p><div class="button-row"><a class="button primary" href="/projects/decision-intelligence-engine/">Explore the project & app →</a><a class="text-link" href="https://github.com/jacobhroutzong/decision-intelligence-engine" target="_blank" rel="noopener noreferrer">Source code ↗</a></div></div></article>{projects.length > 0 && <section class="section"><h2>More project walkthroughs.</h2><div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div></section>}<section class="section"><h2>Work in progress.</h2><p>For the broader collection of repositories and experiments, explore the activity tracker.</p><a class="text-link" href="/activity/">View recent GitHub & Hugging Face activity ↗</a></section></div></Base>
<style>.curated-project{padding:35px;border:1px solid var(--border);background:var(--bg-soft);border-radius:8px}.curated-project h2{margin:16px 0}.curated-project p{max-width:680px;font-size:15px}.curated-project .eyebrow{font-size:10px}@media(max-width:760px){.curated-project{padding:24px}}</style>
