---
import ContactForm from '../components/ContactForm.astro';
import Base from '../layouts/Base.astro';
import { profile, socialLinks } from '../config/profile';
import activity from '../data/activity.json';
import { combineRepositories } from '../lib/repositories.mjs';
import ProjectGroup from '../components/ProjectGroup.astro';
import SelectedProjectCard from '../components/SelectedProjectCard.astro';
import { projectGroups, projectsInGroup } from '../data/selected-projects';
const groups = projectGroups.map(group => ({
  ...group,
  cards: projectsInGroup(group.id).map(project => ({
    ...project,
    title: project.homeTitle ?? project.title,
    links: [{ primary: true, href: project.href, label: project.linkLabel }]
  }))
}));
const repositories = combineRepositories(activity.items);
const featuredRepo = repositories.find(repo => repo.links.some(link => link.url === 'https://github.com/jacobhroutzong/coding-challenges'));
const repos = repositories.filter(repo => repo !== featuredRepo);
const date = (value: string | null) => value ? new Date(value).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'}) : null;
---
<Base title="About me" description="Jacob Routzong’s work in AI, data, and engineering. Explore recent repositories, interactive projects, and public profiles."><div class="container personal-home">
<section id="about" class="introduction"><div class="eyebrow">ABOUT ME</div><h1>{profile.name}</h1><p class="lead">I’m building projects in AI, data, and engineering, with a focus on turning ideas in code into applications you can explore.</p><p>This site brings that work together. My recent repositories show what I’m working on, while the Work section collects projects with their own walkthroughs and interactive pages.</p><div class="intro-links">{socialLinks.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}<a href="/projects/">Explore my work →</a></div></section>
<nav class="home-index" aria-label="On this page"><span>ON THIS PAGE</span><a href="#projects">My work ↓</a><a href="#repositories">Repositories ↓</a><a href="#contact">Contact ↓</a></nav>
<section id="projects" class="home-section">
  <div class="section-heading">
    <div><div class="eyebrow">FROM THE PORTFOLIO</div><h2>My work.</h2></div>
    <a class="text-link" href="/projects/">All work ↗</a>
  </div>
  {groups.map(({ id, title, cards }) => (
    <ProjectGroup id={id} title={title} heading="h3" count={cards.length}>
      {cards.slice(0, 3).map(card => <SelectedProjectCard {...card} compact />)}
      <Fragment slot="more">
        {cards.slice(3).map(card => <SelectedProjectCard {...card} compact />)}
      </Fragment>
    </ProjectGroup>
  ))}
</section>

<section id="repositories" class="home-section"><div class="section-heading"><div><div class="eyebrow">WHAT I’M WORKING ON</div><h2>Repositories.</h2></div><a class="text-link" href="/activity/">All activity ↗</a></div>{featuredRepo && <article class="featured-repository"><div class="eyebrow">FEATURED REPOSITORY</div><h3><a href={featuredRepo.url} target="_blank" rel="noopener noreferrer">Coding Challenges ↗</a></h3><p>{featuredRepo.description || 'Coding practice, original solutions, and experiments across disciplines.'}</p><div class="repo-meta"><span>{featuredRepo.language || 'GitHub'}</span><span>{featuredRepo.updated ? `Last push ${date(featuredRepo.updated)}` : 'Push date unavailable'}</span></div></article>}<p class="other-repositories">Other repositories · GitHub + Hugging Face</p><div class="repo-grid">{repos.map(repo => <article><div class="repo-meta"><span>{repo.links.map(link => link.platform).filter((platform,index,list) => list.indexOf(platform) === index).join(' + ')}{repo.kind === 'Fork' ? ' · Fork' : ''}</span><span>{repo.updated ? `${repo.githubUpdated ? 'Last push' : 'Updated'} ${date(repo.githubUpdated || repo.updated)}` : 'Date unavailable'}</span></div><h3><a href={repo.url} target="_blank" rel="noopener noreferrer">{repo.name} ↗</a></h3><p>{repo.description || 'Explore the source code and documentation.'}</p><div class="repository-links">{repo.links.map(link => <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.platform}{link.platform === 'Hugging Face' ? ` ${link.kind}` : ''} ↗</a>)}</div></article>)}</div><p class="snapshot-note">Coding Challenges is pinned above. Matching GitHub and Hugging Face projects share a card. Sorted by GitHub push date, or Hub update date for Hub-only projects. {activity.fetchedAt && `Snapshot checked ${date(activity.fetchedAt)}.`} <a href="/activity/">View the full tracker →</a></p></section>
<section id="contact" class="home-section"><ContactForm /></section></div></Base>
<style>
.personal-home{max-width:1050px}.introduction{max-width:760px;padding:65px 0 45px}.introduction .eyebrow{margin-bottom:16px}.introduction h1{font:normal clamp(34px,4.5vw,48px)/1.15 Georgia,serif;letter-spacing:-1.5px;margin:0 0 24px}.introduction .lead{font-size:19px;line-height:1.65;margin-bottom:20px}.introduction>p:not(.lead){font-size:15px;max-width:680px}.intro-links{display:flex;flex-wrap:wrap;gap:12px 25px;margin-top:27px}.intro-links a{font-size:12px;color:var(--accent);text-decoration:underline;text-underline-offset:4px}.home-index{display:flex;position:static;gap:25px;flex-wrap:wrap;padding:18px 0;border-block:1px solid var(--border);background:transparent}.home-index span{font:9px monospace;letter-spacing:1px;color:var(--subtle);align-self:center}.home-index a{font-size:11px;padding:0}.home-section{padding:40px 0;scroll-margin-top:110px}.home-section+.home-section{border-top:1px solid var(--border)}.home-section .section-heading{margin-bottom:23px;align-items:center}.home-section .section-heading h2{font-size:28px}.repo-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.repo-grid article{padding:23px;border:1px solid var(--border);border-radius:6px}.repo-meta{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font:10px monospace}.repo-grid h3{font-size:18px;font-weight:500;line-height:1.4;margin:17px 0 10px;overflow-wrap:anywhere}.repo-grid h3 a:hover{color:var(--accent)}.repo-grid p{font-size:13px;margin:0}.snapshot-note{font-size:10px;margin:16px 0 0}.snapshot-note a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}.hub-row{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:23px;border:1px solid var(--border);border-radius:6px}.hub-row .eyebrow{font-size:9px;margin-bottom:12px}.hub-row h3{font-size:20px;overflow-wrap:anywhere;margin-bottom:10px}.hub-row p{font-size:13px;margin:0}.hub-row>span{color:var(--accent)}@media(max-width:760px){.introduction{padding:40px 0 30px}.introduction .lead{font-size:17px}.home-index{display:flex;overflow:visible;width:100%;gap:12px 20px;padding:18px 0}.home-index>span{flex-basis:100%}.repo-grid{grid-template-columns:1fr}.home-section .section-heading h2{font-size:25px}.home-section .section-heading>.text-link{margin-top:0;font-size:11px}.hub-row h3{font-size:18px}}
</style>
