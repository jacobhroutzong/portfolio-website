---
import Base from '../layouts/Base.astro';
import activity from '../data/activity.json';
import { combineRepositories } from '../lib/repositories.mjs';
const items = combineRepositories(activity.items);
---
<Base title="Activity"><div class="container page-shell"><div class="eyebrow">THE WORKBENCH / PUBLIC ACTIVITY</div><h1 class="page-title">Always a work<br /><em>in progress.</em></h1><p class="page-intro">The latest from my Hugging Face and GitHub. Repositories, models, datasets, and experiments, together in one place.</p><div class="activity-tools"><div role="group" aria-label="Filter by platform"><button class="button secondary" data-platform="all" aria-pressed="true">Everything</button><button class="button secondary" data-platform="Hugging Face" aria-pressed="false">Hugging Face</button><button class="button secondary" data-platform="GitHub" aria-pressed="false">GitHub</button></div><span class="small muted">{activity.fetchedAt ? `Snapshot checked ${new Date(activity.fetchedAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}` : 'First sync pending'}</span></div><p class="small muted">Matching GitHub and Hugging Face projects share a card. Ordered by GitHub push date, or Hub update date for Hub-only projects. Forks are labeled.</p><div class="activity-list">{items.map(item => <article class="activity-item" data-activity-platform={item.links.map(link => link.platform).join('|')}><div><span class="eyebrow">{item.platform} / {item.kind}{item.archived ? ' / Archived' : ''}</span><h2><a href={item.url} target="_blank" rel="noopener noreferrer">{item.name} ↗</a></h2><p>{item.description || 'Explore the source and documentation.'}</p><div class="repository-links">{item.links.map(link => <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.platform}{link.platform === 'Hugging Face' ? ` ${link.kind}` : ''} ↗</a>)}</div><span class="small muted">{item.language}{item.language && item.updated ? ' · ' : ''}{item.updated ? `Updated ${new Date(item.updated).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}` : 'Update date unavailable'}</span></div></article>)}</div><p id="activity-empty" class="notice" hidden={activity.items.length > 0}>No public items in this view yet. You can also explore my profiles directly.</p><div class="button-row"><a class="button secondary" href="https://huggingface.co/jacobroutzong" target="_blank" rel="noopener noreferrer">Visit Hugging Face ↗</a><a class="button secondary" href="https://github.com/jacobhroutzong" target="_blank" rel="noopener noreferrer">Visit GitHub ↗</a></div></div></Base>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-platform]');
  const items = document.querySelectorAll<HTMLElement>('[data-activity-platform]');
  buttons.forEach(button => button.addEventListener('click', () => {
    buttons.forEach(other => other.setAttribute('aria-pressed',String(other === button)));
    let count = 0;
    items.forEach(item => { item.hidden = button.dataset.platform !== 'all' && !item.dataset.activityPlatform?.split('|').includes(button.dataset.platform || ''); if (!item.hidden) count++; });
    const empty = document.querySelector<HTMLElement>('#activity-empty');
    if (empty) empty.hidden = count > 0;
  }));
</script>
<style>.activity-tools{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;margin:30px 0}.activity-tools [role=group]{display:flex;gap:8px;flex-wrap:wrap}.activity-tools button[aria-pressed=true]{border-color:var(--accent);color:var(--accent)}.activity-item{padding:28px 0;border-top:1px solid var(--border)}.activity-item h2{font-size:23px;overflow-wrap:anywhere;margin:8px 0}.activity-item p{font-size:14px;max-width:750px;margin-bottom:12px}.activity-item .eyebrow{font-size:9px;margin:0}</style>

<style>.repository-links{display:flex;gap:18px;flex-wrap:wrap;margin:14px 0}</style>
