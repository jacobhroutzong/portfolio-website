---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { visibleProjects } from '../../lib/projects';
import ProjectGroup from '../../components/ProjectGroup.astro';
import SelectedProjectCard from '../../components/SelectedProjectCard.astro';
import { selectedProjects, projectGroups, projectsInGroup } from '../../data/selected-projects';
const workDetails: Record<string,{description:string;links:{primary:boolean;href:string;label:string}[]}> = {
  "Scientific Systems Lab": {
    "description": "Independent computational engines, native binary investigations, and reproducible mathematical tests. Numerical and symbolic cores are in progress; five further engines are planned.",
    "links": [
      {
        "primary": true,
        "href": "/labs/scientific-systems/",
        "label": "Explore the lab →"
      },
      {
        "primary": false,
        "href": "/labs/scientific-systems/numerical/",
        "label": "Numerical engine ↗"
      },
      {
        "primary": false,
        "href": "/labs/scientific-systems/symbolic/",
        "label": "Symbolic engine ↗"
      }
    ]
  }
};
const registeredIds = new Set(selectedProjects.map(project => project.href.split('/').filter(Boolean).at(-1)));
const projects = (await visibleProjects()).filter(project => !registeredIds.has(project.id));
const groups = projectGroups.map(group => ({
  ...group,
  cards: projectsInGroup(group.id).map(project => {
    const details = workDetails[project.title];
    return {
      ...project,
      description: details?.description ?? project.description,
      links: details?.links ?? [{ primary: true, href: project.href, label: project.linkLabel }]
    };
  })
}));
---
<Base title="Work"><div class="container page-shell"><div class="eyebrow">WORK / SELECTED PROJECTS</div><h1 class="page-title">Projects.</h1><p class="page-intro">Applications and project walkthroughs, each with a page of its own.</p>
{groups.map(({ id, title, cards }) => (
  <ProjectGroup id={id} title={title} heading="h2" count={cards.length}>
    {cards.slice(0, 3).map(card => <SelectedProjectCard {...card} />)}
    <Fragment slot="more">
      {cards.slice(3).map(card => <SelectedProjectCard {...card} />)}
    </Fragment>
  </ProjectGroup>
))}
{projects.length > 0 && <section class="section"><h2>More project walkthroughs.</h2><div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div></section>}<section class="section"><h2>Work in progress.</h2><p>For the broader collection of repositories and experiments, explore the activity tracker.</p><a class="text-link" href="/activity/">View recent GitHub & Hugging Face activity ↗</a></section></div></Base>
