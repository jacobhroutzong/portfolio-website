---
import Base from '../../layouts/Base.astro';
import { selectedProjects } from '../../data/selected-projects';

const project = selectedProjects.find(project => project.href === '/projects/video-game-tracker/')!;
---

<Base title={project.title} description={project.description}>
  <article class="container page-shell project-detail">
    <a class="text-link" href="/projects/">← All projects</a>
    <p class="eyebrow detail-eyebrow">{project.eyebrow}</p>
    <h1 class="page-title">{project.title}</h1>
    <p class="page-intro">{project.description}</p>
    <a class="button primary" href="https://rs-comp-optimizer.jacobroutzong.workers.dev/">Open Video Game Tracker →</a>
  </article>
</Base>
