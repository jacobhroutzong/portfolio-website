---
interface Props {
  id: string;
  title: string;
  heading: 'h2' | 'h3';
  count: number;
}

const { id, title, heading: Heading, count } = Astro.props;
const remaining = count - 3;
---
<section class="project-group" aria-labelledby={id}>
  <Heading id={id}>{title}</Heading>
  <div class="cards"><slot /></div>
  {remaining > 0 && (
    <details>
      <summary>
        <span class="more">Show {remaining} more {remaining === 1 ? 'project' : 'projects'}</span>
        <span class="fewer">Show fewer projects</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </summary>
      <div class="cards"><slot name="more" /></div>
    </details>
  )}
</section>

<style>
  .project-group + .project-group { margin-top: 32px; }
  .project-group > :is(h2, h3) { margin: 0 0 14px; }
  .cards { display: grid; gap: 16px; }
  details { margin-top: 18px; }
  details > .cards { margin-top: 16px; }
  summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--accent);
    font-size: 12px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--bg-soft); }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  details:not([open]) .fewer, details[open] .more { display: none; }
  details[open] svg { transform: rotate(180deg); }
  @media (prefers-reduced-motion: no-preference) {
    summary svg { transition: transform .15s; }
  }
</style>
