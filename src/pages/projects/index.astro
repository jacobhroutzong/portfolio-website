---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { visibleProjects } from '../../lib/projects';
import { selectedProjects } from '../../data/selected-projects';
const workDetails: Record<string,{description:string;links:{primary:boolean;href:string;label:string}[]}> = {
  "Ascent — AI Lab Preparation": {
    "description": "A local-first learning workspace with short lessons, original Python problems, spaced reviews, and progress tracking.",
    "links": [
      {
        "primary": true,
        "href": "/ascent/",
        "label": "Open Ascent →"
      },
      {
        "primary": false,
        "href": "/projects/ascent/",
        "label": "Project walkthrough ↗"
      },
      {
        "primary": false,
        "href": "https://github.com/jacobhroutzong/portfolio-website",
        "label": "Source code ↗"
      }
    ]
  },
  "Decision Intelligence Engine": {
    "description": "An interactive control room for telemetry inputs, structured decision routing, confidence gates, and audit output.",
    "links": [
      {
        "primary": true,
        "href": "/projects/decision-intelligence-engine/",
        "label": "Explore the project & app →"
      },
      {
        "primary": false,
        "href": "https://github.com/jacobhroutzong/decision-intelligence-engine",
        "label": "Source code ↗"
      }
    ]
  },
  "Harness² Lab": {
    "description": "A from-scratch implementation of recursive agent harnessing. Inspect proposals, execution traces, composed harnesses, and lessons carried between tasks.",
    "links": [
      {
        "primary": true,
        "href": "/projects/harness2-lab/",
        "label": "Explore the project & app →"
      },
      {
        "primary": false,
        "href": "https://github.com/jacobhroutzong/harness2-lab",
        "label": "Source code ↗"
      }
    ]
  },
  "EquityScout": {
    "description": "A private acquisition research workstation with evidence gates, transparent refinance scenarios, and Southeast-first research. Explore the public synthetic calculator and project walkthrough.",
    "links": [
      {
        "primary": true,
        "href": "/projects/equityscout/",
        "label": "Explore EquityScout →"
      },
      {
        "primary": false,
        "href": "/apps/equityscout/",
        "label": "Try the synthetic calculator ↗"
      }
    ]
  },
  "Scientific Systems Lab": {
    "description": "Independent computational engines, native binary investigations, and reproducible mathematical tests. Numerical and symbolic cores are in progress; five further engines are planned.",
    "links": [
      {
        "primary": true,
        "href": "/labs/scientific-systems/",
        "label": "Explore the lab →"
      },
      {
        "primary": false,
        "href": "/labs/scientific-systems/numerical/",
        "label": "Numerical engine ↗"
      },
      {
        "primary": false,
        "href": "/labs/scientific-systems/symbolic/",
        "label": "Symbolic engine ↗"
      }
    ]
  }
};
const orderedProjects = selectedProjects.toReversed();
const registeredIds = new Set(orderedProjects.map(project => project.href.split('/').filter(Boolean).at(-1)));
const projects = (await visibleProjects()).filter(project => !registeredIds.has(project.id));
---
<Base title="Work"><div class="container page-shell"><div class="eyebrow">WORK / SELECTED PROJECTS</div><h1 class="page-title">Projects.</h1><p class="page-intro">Applications and project walkthroughs, each with a page of its own.</p>{orderedProjects.map(project => { const details = workDetails[project.title]; const links = details?.links || [{primary:true,href:project.href,label:project.linkLabel}]; return <article class="curated-project"><div><span class="eyebrow">{project.eyebrow}</span><h2>{project.title}</h2><p>{details?.description || project.description}</p><div class="button-row">{links.map(link => <a class={link.primary ? 'button primary' : 'text-link'} href={link.href} target={link.href.startsWith('https:') ? '_blank' : undefined} rel={link.href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{link.label}</a>)}</div></div></article>; })}{projects.length > 0 && <section class="section"><h2>More project walkthroughs.</h2><div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div></section>}<section class="section"><h2>Work in progress.</h2><p>For the broader collection of repositories and experiments, explore the activity tracker.</p><a class="text-link" href="/activity/">View recent GitHub & Hugging Face activity ↗</a></section></div></Base>
<style>.curated-project{padding:35px;border:1px solid var(--border);background:var(--bg-soft);border-radius:8px}.curated-project+.curated-project{margin-top:24px}.curated-project h2{margin:16px 0}.curated-project p{max-width:680px;font-size:15px}.curated-project .eyebrow{font-size:10px}@media(max-width:760px){.curated-project{padding:24px}}</style>
