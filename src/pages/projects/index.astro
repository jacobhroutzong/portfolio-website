---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { visibleProjects } from '../../lib/projects';
const projects = (await visibleProjects()).filter(project => !['ascent', 'harness2-lab', 'equityscout'].includes(project.id));
---
<Base title="Work"><div class="container page-shell"><div class="eyebrow">WORK / SELECTED PROJECTS</div><h1 class="page-title">Projects.</h1><p class="page-intro">Applications and project walkthroughs, each with a page of its own.</p><article class="curated-project"><div><span class="eyebrow">PYTHON · MACHINE LEARNING / INTERACTIVE LEARNING</span><h2>Ascent — AI Lab Preparation</h2><p>A local-first learning workspace with short lessons, original Python problems, spaced reviews, and progress tracking.</p><div class="button-row"><a class="button primary" href="/ascent/">Open Ascent →</a><a class="text-link" href="/projects/ascent/">Project walkthrough ↗</a><a class="text-link" href="https://github.com/jacobhroutzong/portfolio-website" target="_blank" rel="noopener noreferrer">Source code ↗</a></div></div></article><article class="curated-project"><div><span class="eyebrow">PYTHON · GRADIO / INTERACTIVE APPLICATION</span><h2>Decision Intelligence Engine</h2><p>An interactive control room for telemetry inputs, structured decision routing, confidence gates, and audit output.</p><div class="button-row"><a class="button primary" href="/projects/decision-intelligence-engine/">Explore the project & app →</a><a class="text-link" href="https://github.com/jacobhroutzong/decision-intelligence-engine" target="_blank" rel="noopener noreferrer">Source code ↗</a></div></div></article><article class="curated-project"><div><span class="eyebrow">PYTHON · AGENT SYSTEMS / INTERACTIVE LAB</span><h2>Harness² Lab</h2><p>A from-scratch implementation of recursive agent harnessing. Inspect proposals, execution traces, composed harnesses, and lessons carried between tasks.</p><div class="button-row"><a class="button primary" href="/projects/harness2-lab/">Explore the project &amp; app →</a><a class="text-link" href="https://github.com/jacobhroutzong/harness2-lab" target="_blank" rel="noopener noreferrer">Source code ↗</a></div></div></article><article class="curated-project"><div><span class="eyebrow">PYTHON · REAL ESTATE / DETERMINISTIC UNDERWRITING</span><h2>EquityScout</h2><p>A private acquisition research workstation with evidence gates, transparent refinance scenarios, and Southeast-first research. Explore the public synthetic calculator and project walkthrough.</p><div class="button-row"><a class="button primary" href="/projects/equityscout/">Explore EquityScout →</a><a class="text-link" href="/apps/equityscout/">Try the synthetic calculator ↗</a></div></div></article>{projects.length > 0 && <section class="section"><h2>More project walkthroughs.</h2><div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div></section>}<section class="section"><h2>Work in progress.</h2><p>For the broader collection of repositories and experiments, explore the activity tracker.</p><a class="text-link" href="/activity/">View recent GitHub & Hugging Face activity ↗</a></section></div></Base>
<style>.curated-project{padding:35px;border:1px solid var(--border);background:var(--bg-soft);border-radius:8px}.curated-project+.curated-project{margin-top:24px}.curated-project h2{margin:16px 0}.curated-project p{max-width:680px;font-size:15px}.curated-project .eyebrow{font-size:10px}@media(max-width:760px){.curated-project{padding:24px}}</style>
