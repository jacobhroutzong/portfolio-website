---
import Base from '../layouts/Base.astro';
import { profile, socialLinks } from '../config/profile';
import activity from '../data/activity.json';
const repos = activity.items.filter(item => item.platform === 'GitHub' && item.kind !== 'Fork').slice(0,4);
const hub = activity.items.filter(item => item.platform === 'Hugging Face').slice(0,2);
const date = (value: string | null) => value ? new Date(value).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'}) : null;
---
<Base title="About me" description="Jacob Routzong’s work in AI, data, and engineering. Explore recent repositories, interactive projects, and public profiles."><div class="container personal-home">
<section id="about" class="introduction"><div class="eyebrow">ABOUT ME</div><h1>{profile.name}</h1><p class="lead">I’m building projects in AI, data, and engineering, with a focus on turning ideas in code into applications you can explore.</p><p>This site brings that work together. My recent repositories show what I’m working on, while the Work section collects selected projects with their own walkthroughs and interactive pages.</p><div class="intro-links">{socialLinks.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}<a href="/projects/">Explore my work →</a></div></section>
<nav class="home-index" aria-label="On this page"><span>ON THIS PAGE</span><a href="#projects">Selected projects ↓</a><a href="#huggingface">Hugging Face ↓</a><a href="#repositories">Recent repositories ↓</a></nav>
<section id="projects" class="home-section"><div class="section-heading"><div><div class="eyebrow">FROM THE PORTFOLIO</div><h2>Selected projects.</h2></div><a class="text-link" href="/projects/">All work ↗</a></div><article class="selected-project"><div><span class="eyebrow">PYTHON / MACHINE LEARNING / FROM SCRATCH</span><h3>Ascent — AI Lab Preparation</h3><p>A local-first workspace for building programming and ML foundations through short lessons, original coding problems, and spaced practice.</p></div><a class="button primary" href="/ascent/">Open Ascent →</a></article><article class="selected-project"><div><span class="eyebrow">PYTHON / GRADIO / INTERACTIVE APPLICATION</span><h3>Decision Intelligence Engine</h3><p>Explore telemetry inputs, structured decision routing, and confidence gates in an interactive control room.</p></div><a class="button primary" href="/projects/decision-intelligence-engine/">Explore project →</a></article></section>
<section id="huggingface" class="home-section"><div class="section-heading"><h2>On Hugging Face.</h2><a class="text-link" href={profile.social.huggingface} target="_blank" rel="noopener noreferrer">View profile ↗</a></div>{hub.map(item => <a class="hub-row" href={item.url} target="_blank" rel="noopener noreferrer"><div><span class="eyebrow">{item.kind}</span><h3>{item.name}</h3><p>{item.description || 'Explore the hosted application on Hugging Face.'}</p></div><span>↗</span></a>)}</section>
<section id="repositories" class="home-section"><div class="section-heading"><div><div class="eyebrow">WHAT I’M WORKING ON</div><h2>Recent repositories.</h2></div><a class="text-link" href="/activity/">All activity ↗</a></div><div class="repo-grid">{repos.map(repo => <article><div class="repo-meta"><span>{repo.language || 'GitHub'}</span><span>{repo.updated ? date(repo.updated) : 'Date unavailable'}</span></div><h3><a href={repo.url} target="_blank" rel="noopener noreferrer">{repo.name} ↗</a></h3><p>{repo.description || 'Explore the source code and documentation on GitHub.'}</p></article>)}</div><p class="snapshot-note">Ordered by latest push. {activity.fetchedAt && `Snapshot checked ${date(activity.fetchedAt)}.`} <a href="/activity/">View the full tracker →</a></p></section>
</div></Base>
<style>
.personal-home{max-width:1050px}.introduction{max-width:760px;padding:65px 0 45px}.introduction .eyebrow{margin-bottom:16px}.introduction h1{font:normal clamp(34px,4.5vw,48px)/1.15 Georgia,serif;letter-spacing:-1.5px;margin:0 0 24px}.introduction .lead{font-size:19px;line-height:1.65;margin-bottom:20px}.introduction>p:not(.lead){font-size:15px;max-width:680px}.intro-links{display:flex;flex-wrap:wrap;gap:12px 25px;margin-top:27px}.intro-links a{font-size:12px;color:var(--accent);text-decoration:underline;text-underline-offset:4px}.home-index{display:flex;position:static;gap:25px;flex-wrap:wrap;padding:18px 0;border-block:1px solid var(--border);background:transparent}.home-index span{font:9px monospace;letter-spacing:1px;color:var(--subtle);align-self:center}.home-index a{font-size:11px;padding:0}.home-section{padding:40px 0;scroll-margin-top:110px}.home-section+.home-section{border-top:1px solid var(--border)}.home-section .section-heading{margin-bottom:23px;align-items:center}.home-section .section-heading h2{font-size:28px}.repo-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.repo-grid article{padding:23px;border:1px solid var(--border);border-radius:6px}.repo-meta{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font:10px monospace}.repo-grid h3{font-size:18px;font-weight:500;line-height:1.4;margin:17px 0 10px;overflow-wrap:anywhere}.repo-grid h3 a:hover{color:var(--accent)}.repo-grid p{font-size:13px;margin:0}.snapshot-note{font-size:10px;margin:16px 0 0}.snapshot-note a{color:var(--accent)}.hub-row{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:23px;border:1px solid var(--border);border-radius:6px}.hub-row .eyebrow{font-size:9px;margin-bottom:12px}.hub-row h3{font-size:20px;overflow-wrap:anywhere;margin-bottom:10px}.hub-row p{font-size:13px;margin:0}.hub-row>span{color:var(--accent)}.selected-project{display:flex;justify-content:space-between;align-items:center;gap:30px;padding:28px;background:var(--bg-soft);border:1px solid var(--border);border-radius:6px}.selected-project .eyebrow{font-size:9px;margin-bottom:14px}.selected-project h3{font-size:23px;margin-bottom:12px}.selected-project p{font-size:14px;max-width:570px;margin:0}.selected-project+.selected-project{margin-top:16px}.selected-project .button{flex-shrink:0}@media(max-width:760px){.introduction{padding:40px 0 30px}.introduction .lead{font-size:17px}.home-index{display:flex;overflow:visible;width:100%;gap:12px 20px;padding:18px 0}.home-index>span{flex-basis:100%}.repo-grid{grid-template-columns:1fr}.home-section .section-heading h2{font-size:25px}.home-section .section-heading>.text-link{margin-top:0;font-size:11px}.selected-project{align-items:start;flex-direction:column;padding:23px}.hub-row h3{font-size:18px}}
</style>
