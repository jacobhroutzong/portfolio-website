---
import Base from '../../../../layouts/Base.astro';
import DecisionEvaluationControls from '../../../../components/DecisionEvaluationControls.astro';
import DecisionEvaluationResult from '../../../../components/DecisionEvaluationResult.astro';
import DecisionScenarioNav from '../../../../components/DecisionScenarioNav.astro';
import DecisionTelemetryFields from '../../../../components/DecisionTelemetryFields.astro';
import { orderBookActionLabels } from '../../../../lib/decision-contract.mjs';
import metadata from '../../../../data/decision-scenarios.json';
import '../../../../styles/decision-workbench.css';

const scenario = metadata.scenarios.lob_risk;
const [age, spread, depth] = scenario.inputs;
const fields = [
  { ...age, label: 'Market data age', help: 'Time since the last market data update. A larger value means an older snapshot.' },
  { ...spread, label: 'Bid–ask spread', help: 'Gap between the best bid and ask, in basis points. One basis point equals 0.01%.' },
  { ...depth, label: 'Displayed depth lost', help: 'Share of displayed quantity lost at the best bid and ask, relative to the example baseline.' },
];
---
<Base title="Order book risk · Workbench preview" description="Explore how stale market data, a wider spread, and less displayed liquidity affect a simulated quoting decision." noindex={true}>
  <div class="decision-workbench container">
    <header class="dw-opening">
      <a class="dw-back" href="/projects/decision-intelligence-engine/">← Decision Intelligence Engine</a>
      <h1>Order book risk</h1>
      <p>Explore how stale quotes and thinning liquidity change the model’s recommendation in a simulated market.</p>
      <a class="dw-scenarios" href="/projects/decision-intelligence-engine/#application">Original seven-scenario app</a>
    </header>
    <DecisionScenarioNav active="order-book" />
    <div class="dw-workspace">
      <form id="order-book-telemetry" class="dw-inputs">
        <div class="dw-section-heading"><h2>Telemetry</h2><button class="dw-reset" type="reset">Reset defaults</button></div>
        <p class="dw-input-intro">Start with an example or enter your own estimates.</p>
        <div class="dw-presets" role="group" aria-label="Telemetry examples">
          <button type="button" data-example="thin" aria-pressed="true">Thin market</button>
          <button type="button" data-example="fresh" aria-pressed="false">Fresh, liquid market</button>
        </div>
        <DecisionTelemetryFields fields={fields} />
        <DecisionEvaluationControls />
        <noscript><p>Enable JavaScript to update the readout.</p></noscript>
      </form>
      <div class="dw-readout">
        <section class="dw-comparison" aria-labelledby="depth-title">
          <p class="dw-kicker">From your inputs</p>
          <div class="dw-section-heading"><h2 id="depth-title">Displayed liquidity</h2></div>
          <div class="dw-time">
            <div><span>Displayed depth remaining</span><output id="depth-remaining" for={depth.id} aria-live="off">{100 - depth.value}%</output></div>
            <div class="dw-track" aria-hidden="true"><span id="depth-bar" style={`width:${100 - depth.value}%`}></span></div>
            <div class="dw-axis" aria-hidden="true"><span>0%</span><span>100% of baseline</span></div>
          </div>
          <div class="dw-time"><div><span>Spread as a percentage</span><output id="spread-percent" for={spread.id} aria-live="off">{(spread.value / 100).toFixed(2)}%</output></div></div>
          <p class="dw-caveat">Depth remaining is 100% minus the entered loss. Displayed depth can change before an order executes.</p>
          <p id="input-error" role="status" hidden></p>
        </section>
        <DecisionEvaluationResult actionLabels={orderBookActionLabels} riskLabel="Quoting risk" riskHelp="Model estimate that quoting should pause until market data and liquidity are checked" severityHelp="0 normal · 4 critical disruption" />
      </div>
    </div>
    <div class="dw-evidence">
      <details><summary>Possible quoting responses</summary><dl class="dw-dispatch-actions">
        {Object.entries(orderBookActionLabels).map(([key, label]) => <div><dt>{label}</dt><dd>{scenario.choices[key as keyof typeof orderBookActionLabels]}</dd></div>)}
      </dl></details>
      <details><summary>Input payload and model evidence</summary><pre id="order-book-payload"></pre><p id="model-timing" hidden></p><pre id="model-audit" hidden></pre></details>
    </div>
  </div>
</Base>
<script>
  import { orderBookActionLabels, validateTelemetry } from '../../../../lib/decision-contract.mjs';
  import { bindDecisionEvaluation } from '../../../../lib/decision-workbench';

  const scenario = 'lob_risk';
  const form = document.querySelector<HTMLFormElement>('#order-book-telemetry')!;
  const invalidate = bindDecisionEvaluation(form, scenario, orderBookActionLabels);
  const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input[type="number"]'));
  const examples = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-example]'));
  const depth = form.querySelector<HTMLInputElement>('#depth_drop_pct')!;
  const spread = form.querySelector<HTMLInputElement>('#spread_bps')!;
  const remaining = document.querySelector<HTMLOutputElement>('#depth-remaining')!;
  const bar = document.querySelector<HTMLElement>('#depth-bar')!;
  const percent = document.querySelector<HTMLOutputElement>('#spread-percent')!;
  const error = document.querySelector<HTMLElement>('#input-error')!;
  const payload = document.querySelector<HTMLElement>('#order-book-payload')!;
  const freshExample: Record<string, number> = { market_data_age_ms: 20, spread_bps: 4, depth_drop_pct: 8 };

  function update() {
    remaining.value = depth.validity.valid ? `${100 - depth.valueAsNumber}%` : '—';
    bar.style.width = depth.validity.valid ? remaining.value : '0%';
    percent.value = spread.validity.valid ? `${(spread.valueAsNumber / 100).toFixed(2)}%` : '—';
    const telemetry = Object.fromEntries(fields.map(field => [field.name, field.valueAsNumber]));
    try {
      validateTelemetry(telemetry, scenario);
      error.hidden = true;
      payload.textContent = JSON.stringify({ schemaVersion: 1, scenario, telemetry }, null, 2);
    } catch (invalid) {
      error.hidden = false;
      error.textContent = invalid instanceof Error ? invalid.message : 'Check the telemetry inputs.';
      payload.textContent = 'Enter valid values for all three inputs to see the payload.';
    }
  }

  function applyExample(example: string) {
    fields.forEach(field => { field.value = example === 'fresh' ? String(freshExample[field.name]) : field.defaultValue; });
    examples.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.example === example)));
    update();
  }

  form.addEventListener('reset', event => { event.preventDefault(); applyExample('thin'); });
  form.addEventListener('input', event => {
    if (event.target instanceof HTMLInputElement && event.target.type === 'number') {
      examples.forEach(button => button.setAttribute('aria-pressed', 'false'));
      update();
    }
  });
  examples.forEach(button => button.addEventListener('click', () => { invalidate(); applyExample(button.dataset.example!); }));
  update();
</script>
