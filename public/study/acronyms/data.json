        "infantry"
      ],
      "prompt": "What are the eight troop leading procedures?",
      "components": [
        {
          "letter": "1",
          "meaning": "Receive the mission"
        },
        {
          "letter": "2",
          "meaning": "Issue a warning order"
        },
        {
          "letter": "3",
          "meaning": "Make a tentative plan"
        },
        {
          "letter": "4",
          "meaning": "Initiate movement"
        },
        {
          "letter": "5",
          "meaning": "Conduct reconnaissance"
        },
        {
          "letter": "6",
          "meaning": "Complete the plan"
