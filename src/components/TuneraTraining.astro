<section id="tunera-training" class="training" aria-labelledby="tunera-training-title">
  <h2 id="tunera-training-title">Fine-tuning</h2>
  <p>Download a planner configuration, split your JSONL dataset, then run the training CLI on a compatible GPU. Qwen3-4B QLoRA is the default. The Qwen3.5-2B BF16 LoRA reference recipe passed training and checkpoint recovery on an NVIDIA L4. <a href="#qwen35-gpu-validation">See the Colab results</a>.</p>
  <ol>
    <li>Validate and export conversations from Dataset Studio.</li>
    <li>Download a configuration and follow the CLI instructions in the <a href="/downloads/tunera-ai-0.3.1.zip">Qwen3 source release</a>.</li>
    <li>Keep the run directory. Its manifest records the configuration, data and software. A resumable checkpoint also needs optimizer, scheduler and random state.</li>
  </ol>
  <div class="inputs">
    <label>Inspect a run manifest <input type="file" accept=".json,application/json" data-run-manifest /></label>
    <label>Inspect a checkpoint pointer <input type="file" accept=".json,application/json" data-checkpoint-pointer /></label>
  </div>
  <p>Files are read in your browser. The view shows what the files report. Checkpoint integrity is verified by the training CLI.</p>
  <p role="status" data-training-status></p>
  <dl data-run-details></dl>
</section>

<script>
  const panel = document.querySelector<HTMLElement>('#tunera-training');
  if (panel) {
    const status = panel.querySelector<HTMLElement>('[data-training-status]')!;
    const results = panel.querySelector<HTMLElement>('[data-run-details]')!;
    const manifest = panel.querySelector<HTMLInputElement>('[data-run-manifest]')!;
    const checkpoint = panel.querySelector<HTMLInputElement>('[data-checkpoint-pointer]')!;
    const sections = new Map<HTMLInputElement, [string, string][]>();
    for (const input of [manifest, checkpoint]) {
      input.addEventListener('change', async () => {
        const file = input.files?.[0];
        if (!file) return;
        try {
          if (file.size > 1_000_000) throw new Error('Use a JSON artifact up to 1 MB.');
          const value = JSON.parse(await file.text());
          if (input === manifest) {
            if (!['running', 'completed', 'oom', 'interrupted', 'failed'].includes(value?.status) ||
              typeof value.config?.model_id !== 'string' || typeof value.smoke_only !== 'boolean' ||
              !/^[a-f0-9]{64}$/.test(value.dataset_sha256)) throw new Error('Choose a Tunera run manifest.');
            const fields: [string, string][] = [
              ['Reported status', value.status], ['Model', value.config.model_id],
              ['Run type', value.smoke_only ? 'Smoke test' : 'Training run'], ['Dataset SHA-256', value.dataset_sha256],
            ];
            if (typeof value.hardware?.gpu === 'string') fields.push(['Reported GPU', value.hardware.gpu]);
            if (Number.isSafeInteger(value.peak_gpu_allocated_bytes) && value.peak_gpu_allocated_bytes > 0) {
              fields.push(['Reported peak GPU allocation', `${(value.peak_gpu_allocated_bytes / 2 ** 30).toFixed(2)} GiB`]);
            }
            sections.set(input, fields);
          } else {
            if (!/^checkpoint-\d+$/.test(value?.checkpoint)) throw new Error('Choose a Tunera latest_checkpoint.json pointer.');
            sections.set(input, [['Reported checkpoint pointer', value.checkpoint]]);
          }
          status.textContent = 'Artifact loaded locally.';
        } catch (error) {
          sections.delete(input);
          status.textContent = error instanceof Error ? error.message : 'Could not open the artifact.';
        }
        results.replaceChildren();
        for (const fields of sections.values()) {
          for (const [name, content] of fields) {
            const term = document.createElement('dt');
            const detail = document.createElement('dd');
            term.textContent = name;
            detail.textContent = content;
            results.append(term, detail);
          }
        }
        input.value = '';
      });
    }
  }
</script>

<style>
  .training { padding: clamp(1rem, 3vw, 2rem); border: 1px solid var(--border); border-radius: 10px; background: var(--bg-soft); }
  p, ol, dl { margin-block: .65rem; }
  ol { list-style: decimal; padding-left: 1.3rem; }
  .inputs { display: flex; flex-wrap: wrap; gap: .8rem 2rem; margin-block: 1rem; }
  label { display: grid; gap: .4rem; font-size: .875rem; }
  input { max-width: 100%; }
  dt { font-weight: 600; }
  dd { overflow-wrap: anywhere; margin-bottom: .5rem; }
</style>
