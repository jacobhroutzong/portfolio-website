---
import Base from '../../../../layouts/Base.astro';
import DecisionEvaluationControls from '../../../../components/DecisionEvaluationControls.astro';
import DecisionEvaluationResult from '../../../../components/DecisionEvaluationResult.astro';
import DecisionScenarioNav from '../../../../components/DecisionScenarioNav.astro';
import DecisionTelemetryFields from '../../../../components/DecisionTelemetryFields.astro';
import { gpuThermalActionLabels } from '../../../../lib/decision-contract.mjs';
import metadata from '../../../../data/decision-scenarios.json';
import '../../../../styles/decision-workbench.css';

const scenario = metadata.scenarios.gpu_thermal;
const [hotspot, flow, inlet] = scenario.inputs;
const fields = [
  { ...hotspot, label: 'GPU hotspot temperature', help: 'Highest temperature measured on the GPU die.' },
  { ...flow, label: 'Coolant flow', help: 'Measured flow as a percentage of the cooling loop’s nominal flow. Values above 100% are above nominal.' },
  { ...inlet, label: 'Rack inlet temperature', help: 'Temperature of the air entering the rack.' },
];
---
<Base title="GPU thermal · Workbench preview" description="Explore how coolant flow, GPU hotspot temperature, and rack inlet air affect a simulated cooling decision." noindex={true}>
  <div class="decision-workbench container">
    <header class="dw-opening">
      <a class="dw-back" href="/projects/decision-intelligence-engine/">← Decision Intelligence Engine</a>
      <h1>GPU thermal</h1>
      <p>Compare coolant flow with GPU and rack temperatures in a simulated cooling incident.</p>
      <a class="dw-scenarios" href="/projects/decision-intelligence-engine/#application">Original seven-scenario app</a>
    </header>
    <DecisionScenarioNav active="gpu-thermal" />
    <div class="dw-workspace">
      <form id="gpu-thermal-telemetry" class="dw-inputs">
        <div class="dw-section-heading"><h2>Telemetry</h2><button class="dw-reset" type="reset">Reset defaults</button></div>
        <p class="dw-input-intro">Start with an example or enter your own estimates.</p>
        <div class="dw-presets" role="group" aria-label="Telemetry examples">
          <button type="button" data-example="low" aria-pressed="true">Low coolant flow</button>
          <button type="button" data-example="nominal" aria-pressed="false">Nominal cooling</button>
        </div>
        <DecisionTelemetryFields fields={fields} />
        <DecisionEvaluationControls />
        <noscript><p>Enable JavaScript to update the readout.</p></noscript>
      </form>
      <div class="dw-readout">
        <section class="dw-comparison" aria-labelledby="cooling-title">
          <p class="dw-kicker">From your inputs</p>
          <div class="dw-section-heading"><h2 id="cooling-title">Cooling snapshot</h2></div>
          <div class="dw-time">
            <div><span>Coolant flow</span><output id="flow-readout" for={flow.id} aria-live="off">{flow.value}% of nominal</output></div>
            <div class="dw-track" aria-hidden="true"><span id="flow-bar" style={`width:${flow.value / flow.max * 100}%`}></span></div>
            <div class="dw-axis" aria-hidden="true"><span>0%</span><span>{flow.max}% of nominal</span></div>
          </div>
          <div class="dw-time"><div><span>Hotspot minus rack inlet</span><output id="temperature-gap" for={`${hotspot.id} ${inlet.id}`} aria-live="off">{hotspot.value - inlet.value} °C</output></div></div>
          <p class="dw-caveat">Low flow can appear before the hotspot rises. The temperature difference compares the two readings. Hardware limits depend on the equipment.</p>
          <p id="input-error" role="status" hidden></p>
        </section>
        <DecisionEvaluationResult actionLabels={gpuThermalActionLabels} riskLabel="Full-load cooling risk" riskHelp="Model estimate that full-load operation is unsafe pending independent cooling verification" severityHelp="0 normal · 4 critical failure" />
      </div>
    </div>
    <div class="dw-evidence">
      <details><summary>Possible cooling responses</summary><dl class="dw-dispatch-actions">
        {Object.entries(gpuThermalActionLabels).map(([key, label]) => <div><dt>{label}</dt><dd>{scenario.choices[key as keyof typeof gpuThermalActionLabels]}</dd></div>)}
      </dl></details>
      <details><summary>Input payload and model evidence</summary><pre id="gpu-thermal-payload"></pre><p id="model-timing" hidden></p><pre id="model-audit" hidden></pre></details>
    </div>
  </div>
</Base>
<script>
  import { gpuThermalActionLabels, validateTelemetry } from '../../../../lib/decision-contract.mjs';
  import { bindDecisionEvaluation } from '../../../../lib/decision-workbench';

  const scenario = 'gpu_thermal';
  const form = document.querySelector<HTMLFormElement>('#gpu-thermal-telemetry')!;
  const invalidate = bindDecisionEvaluation(form, scenario, gpuThermalActionLabels);
  const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input[type="number"]'));
  const examples = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-example]'));
  const hotspot = form.querySelector<HTMLInputElement>('#gpu_hotspot_c')!;
  const inlet = form.querySelector<HTMLInputElement>('#rack_inlet_c')!;
  const flow = form.querySelector<HTMLInputElement>('#coolant_flow_pct')!;
  const flowReadout = document.querySelector<HTMLOutputElement>('#flow-readout')!;
  const bar = document.querySelector<HTMLElement>('#flow-bar')!;
  const gap = document.querySelector<HTMLOutputElement>('#temperature-gap')!;
  const error = document.querySelector<HTMLElement>('#input-error')!;
  const payload = document.querySelector<HTMLElement>('#gpu-thermal-payload')!;
  const nominal: Record<string, number> = { gpu_hotspot_c: 65, coolant_flow_pct: 100, rack_inlet_c: 24 };

  function update(showError = false) {
    flowReadout.value = flow.validity.valid ? `${flow.valueAsNumber}% of nominal` : '—';
    bar.style.width = flow.validity.valid ? `${flow.valueAsNumber / Number(flow.max) * 100}%` : '0%';
    gap.value = hotspot.validity.valid && inlet.validity.valid ? `${hotspot.valueAsNumber - inlet.valueAsNumber} °C` : '—';
    const telemetry = Object.fromEntries(fields.map(field => [field.name, field.valueAsNumber]));
    try {
      validateTelemetry(telemetry, scenario);
      error.hidden = true;
      payload.textContent = JSON.stringify({ schemaVersion: 1, scenario, telemetry }, null, 2);
    } catch (invalid) {
      error.hidden = !showError;
      error.textContent = invalid instanceof Error ? invalid.message : 'Check the telemetry inputs.';
      payload.textContent = 'Enter valid values for all three inputs to see the payload.';
    }
  }

  function applyExample(example: string) {
    fields.forEach(field => { field.value = example === 'nominal' ? String(nominal[field.name]) : field.defaultValue; });
    examples.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.example === example)));
    update();
  }

  form.addEventListener('reset', event => { event.preventDefault(); applyExample('low'); });
  form.addEventListener('input', event => {
    if (event.target instanceof HTMLInputElement && event.target.type === 'number') {
      examples.forEach(button => button.setAttribute('aria-pressed', 'false'));
      update();
    }
  });
  fields.forEach(field => field.addEventListener('blur', () => update(true)));
  examples.forEach(button => button.addEventListener('click', () => { invalidate(); applyExample(button.dataset.example!); }));
  update();
</script>
