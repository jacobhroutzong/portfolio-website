---
const { active } = Astro.props as { active: 'robotics' | 'aviation' | 'gnss' | 'order-book' | 'gpu-thermal' };
const root = '/projects/decision-intelligence-engine/';
---
<nav class="dw-scenario-nav" aria-label="Workbench scenarios">
  <a href={`${root}workbench/`} aria-current={active === 'robotics' ? 'page' : undefined}>Robotics</a>
  <a href={`${root}workbench/aviation/`} aria-current={active === 'aviation' ? 'page' : undefined}>Aviation dispatch</a>
  <a href={`${root}workbench/gnss/`} aria-current={active === 'gnss' ? 'page' : undefined}>GNSS integrity</a>
  <a href={`${root}workbench/order-book/`} aria-current={active === 'order-book' ? 'page' : undefined}>Order book risk</a>
  <a href={`${root}workbench/gpu-thermal/`} aria-current={active === 'gpu-thermal' ? 'page' : undefined}>GPU thermal</a>
</nav>
