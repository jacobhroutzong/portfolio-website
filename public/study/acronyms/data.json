          "letter": "M",
          "meaning": "Massive hemorrhage"
        },
        {
          "letter": "A",
          "meaning": "Airway"
        },
        {
          "letter": "R",
          "meaning": "Respiration"
        },
        {
          "letter": "C",
          "meaning": "Circulation"
        },
        {
          "letter": "H",
          "meaning": "Hypothermia/Head injury"
        }
      ],
      "note": "The Joint Trauma System guideline groups hypothermia and head injury under H.",
      "sourceIds": [
        "jts-nursing"
      ]
    },
    {
      "id": "tccc",
