{
  "name": "engineering-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "sync:challenges": "node scripts/sync-challenges.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run sync:challenges && npm run images && astro build && node scripts/check-links.mjs",
    "verify": "npm run lint && npm run check && npm test && npm run test:ascent && npm run validate:ascent && npm run build",
    "test:ascent": "vitest run",
    "test:e2e": "playwright test",
    "validate:ascent": "node tools/validate-ascent.mjs",
    "sync:ascent": "node tools/sync-ascent.mjs",
    "images": "node scripts/optimize-images.mjs",
    "predev": "npm run images",
    "sync:activity": "node scripts/sync-activity.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "astro": "7.3.8",
    "katex": "^0.19.1",
    "monaco-editor": "^0.56.0",
    "tailwindcss": "^4.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.3.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
