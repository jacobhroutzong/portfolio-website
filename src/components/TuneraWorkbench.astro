---
const cases = Array.from({ length: 12 }, (_, index) => {
  const n = index + 1;
  return {
    id: `case-${String(n).padStart(2, '0')}`,
    messages: [
      { role: 'user', content: `Return only JSON with key result: ${n} + 2` },
      { role: 'assistant', content: JSON.stringify({ result: n + 2 }) },
    ],
    required_keys: ['result'], scorer: 'json_exact',
  };
});
const jsonl = cases.map(row => JSON.stringify(row)).join('\n');
const predictions = JSON.stringify(Object.fromEntries(cases.map(row => [row.id, row.messages[1].content])), null, 2);
const controls = [
  { name: 'context', label: 'Maximum context tokens', min: 128, max: 4096, step: 128, value: 512, help: 'How much of the prompt and answer fits in one example.' },
  { name: 'rank', label: 'LoRA rank', min: 4, max: 64, step: 4, value: 16, help: 'A higher rank gives the adapter more capacity and uses more memory.' },
  { name: 'steps', label: 'Optimizer steps', min: 2, max: 1000, step: 1, value: 100, help: 'How many times training updates the adapter weights.' },
];
---

<section id="tunera-tools" class="workbench" aria-labelledby="tunera-tools-title">
  <p class="eyebrow">Model · Data · Fine-tune</p>
  <h2 id="tunera-tools-title">Experiment Planner</h2>
  <nav class="actions" aria-label="Tunera workflow">
    <a href="#tunera-tools">Planner</a><a href="#tunera-dataset">Dataset Studio</a>
    <a href="#tunera-training">Fine-tuning</a><a href="#evaluation-lab">Evaluation Lab</a><a href="#tunera-reports">Reports &amp; comparison</a>
  </nav>
  <p>Build a Qwen training plan, check your dataset, or score saved responses. These tools run on CPU and make no model calls.</p>
  <p class="help">Use public or synthetic examples. Inputs are processed on a shared server, which can take a moment to wake up.</p>
  <noscript>Enable JavaScript to use the interactive tools.</noscript>

  <details open>
    <summary>Plan an experiment</summary>
    <form data-tool="plan" method="post">
      <div class="controls">
        <label>Model and training strategy
          <select name="size" aria-describedby="tunera-size-help">
            {['0.6B', '1.7B', '4B', '8B'].map(size => <option value={size} selected={size === '4B'}>Qwen3-{size} · QLoRA</option>)}
            <option value="qwen35">Qwen3.5-2B · Experimental BF16 LoRA (GPU-tested)</option>
          </select>
          <span class="help" id="tunera-size-help" data-recipe-help>Qwen3 QLoRA uses 4-bit base weights. Larger models generally need more GPU memory.</span>
        </label>
        {controls.map(({ name, label, help, ...input }) => (
          <label>{label}
            <input type="number" name={name} {...input} required aria-describedby={`tunera-${name}-help`} />
            <span class="help" id={`tunera-${name}-help`}>{help}</span>
          </label>
        ))}
      </div>
      <div class="actions">
        <button class="button primary" disabled>Build plan</button>
        <button type="button" class="button secondary" data-download-config disabled>Download config</button>
        <a class="text-link" href="#what-the-settings-mean">What the settings mean</a>
      </div>
      <p data-status role="status" class="status"></p>
      <pre data-result aria-label="Experiment plan" tabindex="0" hidden></pre>
    </form>
  </details>

  <details>
    <summary>Estimate GPU memory</summary>
    <div class="panel-body" data-memory>
      <p class="help">Estimated weight storage plus your overhead allowance. Activation and optimizer memory depend on the recipe and can exceed this allowance.</p>
      <div class="controls">
        <label>Parameters (billions)<input name="parameters" type="number" min="0.1" max="1000" step="0.1" value="4" /></label>
        <label>Overhead (GiB)<input name="overhead" type="number" min="0" max="256" step="0.5" value="3" /></label>
        <label>GPU budget (GiB)<select name="budget"><option>8</option><option>12</option><option selected>16</option><option>24</option><option>48</option><option>80</option></select></label>
      </div>
      <ul data-memory-results></ul>
    </div>
  </details>

  <h3 id="tunera-dataset">Dataset Studio</h3>
  <details>
    <summary>Validate a dataset</summary>
    <form data-tool="validate" method="post">
      <p class="help">Check up to 250 conversations (256 KB) and preview the train, validation and test splits.</p>
      <label>Import conversation JSONL <input type="file" accept=".jsonl,.txt" data-dataset-file /></label>
      <div class="controls">
        <label>New user message <input data-user-message /></label>
        <label>Expected assistant reply <input data-assistant-message /></label>
      </div>
      <button type="button" class="button secondary" data-add-case>Add conversation</button>
      <p data-case-preview class="help" role="status"></p>
      <details open>
        <summary>Advanced · inspect or edit records</summary>
        <label>Conversation cases (JSONL)
          <textarea name="cases" rows="8" required spellcheck="false">{jsonl}</textarea>
        </label>
        <button type="button" class="button secondary" data-download-dataset>Download JSONL</button>
      </details>
      <button class="button primary" disabled>Validate dataset</button>
      <p data-status role="status" class="status"></p>
      <pre data-result aria-label="Dataset validation report" tabindex="0" hidden></pre>
    </form>
  </details>

  <details>
    <summary>Score saved responses</summary>
    <form data-tool="score" method="post">
      <p class="help">Match one saved response to each reference case ID. The included examples should score 100%.</p>
      <label>Reference cases (JSONL)
        <textarea name="cases" rows="6" required spellcheck="false">{jsonl}</textarea>
      </label>
      <label>Predictions (JSON object)
        <textarea name="predictions" rows="6" required spellcheck="false">{predictions}</textarea>
      </label>
      <button class="button primary" disabled>Score responses</button>
      <p data-status role="status" class="status"></p>
      <pre data-result aria-label="Saved response scores" tabindex="0" hidden></pre>
    </form>
  </details>
</section>

<script>
  import { estimateMemory } from '../lib/tunera-reports.mjs';
  import qwen35Recipe from '../data/tunera-qwen35-recipe.json';

  function saveText(contents: string, filename: string) {
    const url = URL.createObjectURL(new Blob([contents], { type: 'text/plain' }));
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    link.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('#tunera-tools form[data-tool]')) {
    const button = form.querySelector<HTMLButtonElement>('button.primary')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const output = form.querySelector<HTMLElement>('[data-result]')!;
    const download = form.querySelector<HTMLButtonElement>('[data-download-config]');
    const model = form.querySelector<HTMLSelectElement>('[name=size]');
    let configJson = '';
    download?.addEventListener('click', () => saveText(configJson, 'tunera-config.json'));
    model?.addEventListener('change', () => {
      const usesQwen35 = model.value === 'qwen35';
      const defaults = usesQwen35 ? [qwen35Recipe.max_length, qwen35Recipe.rank, qwen35Recipe.max_steps] : [512, 16, 100];
      ['context', 'rank', 'steps'].forEach((name, index) => {
        form.querySelector<HTMLInputElement>(`[name=${name}]`)!.value = String(defaults[index]);
      });
      form.querySelector('[data-recipe-help]')!.textContent = usesQwen35
        ? 'The reference recipe passed training and checkpoint recovery on a Colab L4. It requires native BF16 CUDA and a separate runtime.'
        : 'Qwen3 QLoRA uses 4-bit base weights. Larger models generally need more GPU memory.';
      const params = document.querySelector<HTMLInputElement>('[data-memory] [name=parameters]');
      if (params) {
        params.value = String(usesQwen35 ? 2 : Number.parseFloat(model.value));
        params.dispatchEvent(new Event('input', { bubbles: true }));
      }
      output.hidden = true;
      status.textContent = '';
      if (download) download.disabled = true;
    });
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (button.disabled) return;
      const values = new FormData(form);
      const action = form.dataset.tool;
      const fields = action === 'plan'
        ? { size: values.get('size'), context: Number(values.get('context')), rank: Number(values.get('rank')), steps: Number(values.get('steps')) }
        : Object.fromEntries(values);

      output.hidden = true;
      if (download) download.disabled = true;
      status.textContent = 'Working…';
      button.disabled = true;
      if (model) model.disabled = true;
      try {
        for (const name of ['cases', 'predictions']) {
          const text = values.get(name);
          if (typeof text === 'string' && new TextEncoder().encode(text).length > 256_000) {
            throw new Error('Each text field is limited to 256 KB.');
          }
        }
        let result;
        if (action === 'plan' && fields.size === 'qwen35') {
          result = {
            config: { ...qwen35Recipe, max_length: fields.context, rank: fields.rank, max_steps: fields.steps },
            strategy: 'BF16 LoRA',
            status: 'Configuration only. The reference recipe was GPU-tested on a Colab L4. Use the dedicated runner and a native BF16 CUDA GPU.',
          };
        } else {
          const response = await fetch('/api/tunera', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...fields, action }),
          }).catch(() => null);
          result = await response?.json().catch(() => null);
          if (!response?.ok || !result) {
            throw new Error(result?.error || 'Tunera is temporarily unavailable. Try again in a moment.');
          }
        }
        output.textContent = JSON.stringify(result, null, 2);
        output.hidden = false;
        if (download) {
          configJson = JSON.stringify(result.config, null, 2);
          download.disabled = false;
        }
        status.textContent = action === 'score' ? `Accuracy: ${(result.accuracy * 100).toFixed(1)}% across ${result.count} cases.`
          : action === 'validate' ? `${result.rows} conversations passed validation.` : 'Training plan ready.';
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Could not complete this request.';
      } finally {
        button.disabled = false;
        if (model) model.disabled = false;
      }
    });
    button.disabled = false;
  }

  const dataset = document.querySelector<HTMLFormElement>('#tunera-tools [data-tool="validate"]');
  if (dataset) {
    const cases = dataset.querySelector<HTMLTextAreaElement>('textarea[name="cases"]')!;
    const preview = dataset.querySelector<HTMLElement>('[data-case-preview]')!;
    const file = dataset.querySelector<HTMLInputElement>('[data-dataset-file]')!;
    const user = dataset.querySelector<HTMLInputElement>('[data-user-message]')!;
    const assistant = dataset.querySelector<HTMLInputElement>('[data-assistant-message]')!;
    const update = () => { preview.textContent = `${cases.value.split(/\r?\n/).filter(line => line.trim()).length} records ready to validate.`; };
    update();
    cases.addEventListener('input', update);
    file.addEventListener('change', async () => {
      const selected = file.files?.[0];
      if (!selected) return;
      try {
        if (selected.size > 256_000) throw new Error('Dataset file exceeds 256 KB.');
        cases.value = await selected.text();
        update();
      } catch (error) { preview.textContent = error instanceof Error ? error.message : 'Could not read this dataset.'; }
      file.value = '';
    });
    dataset.querySelector('[data-add-case]')?.addEventListener('click', () => {
      if (!user.value.trim() || !assistant.value.trim()) {
        preview.textContent = 'Enter both messages to add a conversation.';
        return;
      }
      const row = { id: `case-${crypto.randomUUID()}`, messages: [{ role: 'user', content: user.value }, { role: 'assistant', content: assistant.value }] };
      const updated = [cases.value.trimEnd(), JSON.stringify(row)].filter(Boolean).join('\n');
      if (new TextEncoder().encode(updated).length > 256_000) {
        preview.textContent = 'Dataset exceeds 256 KB.';
        return;
      }
      cases.value = updated;
      user.value = assistant.value = '';
      update();
    });
    dataset.querySelector('[data-download-dataset]')?.addEventListener('click', () => saveText(cases.value, 'tunera-dataset.jsonl'));
  }

  const memory = document.querySelector<HTMLElement>('[data-memory]');
  if (memory) {
    const parameters = memory.querySelector<HTMLInputElement>('[name=parameters]')!;
    const overhead = memory.querySelector<HTMLInputElement>('[name=overhead]')!;
    const budget = memory.querySelector<HTMLSelectElement>('[name=budget]')!;
    const output = memory.querySelector('[data-memory-results]')!;
    function updateMemory() {
      output.replaceChildren();
      if (!parameters.value || !overhead.value || !parameters.validity.valid || !overhead.validity.valid) return;
      for (const row of estimateMemory(parameters.valueAsNumber, overhead.valueAsNumber, Number(budget.value))) {
        const item = document.createElement('li');
        item.textContent = `${row.bits}-bit weights: ${row.weights.toFixed(2)} GiB · ${row.total.toFixed(2)} GiB with allowance · ${Math.abs(row.headroom).toFixed(2)} GiB ${row.headroom >= 0 ? 'under' : 'over'} budget`;
        output.append(item);
      }
    }
    memory.addEventListener('input', updateMemory);
    updateMemory();
  }
</script>

<style>
  .workbench { margin-block: 2rem 3rem; padding: clamp(1rem, 3vw, 2rem); border: 1px solid var(--border); border-radius: 10px; background: var(--bg-soft); }
  h2 { margin: 0 0 .5rem; }
  p { margin: 0 0 .75rem; }
  h3 { margin: 1.5rem 0 0; }
  .help, .status { color: var(--muted); font-size: .875rem; }
  details { margin-top: 1rem; border: 1px solid var(--border); border-radius: 6px; background: var(--bg); }
  summary { cursor: pointer; padding: .85rem 1rem; font-weight: 600; }
  form { display: grid; gap: 1rem; padding: .5rem 1rem 1rem; }
  .panel-body, form details label, form details button { margin: .5rem 1rem 1rem; }
  .controls { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  label { display: grid; align-content: start; gap: .4rem; color: var(--text); font-size: .9375rem; }
  input, select, textarea, pre { width: 100%; border: 1px solid var(--border-strong); border-radius: 5px; background: var(--bg-soft); color: var(--text); padding: .6rem; }
  textarea, pre { font-family: monospace; font-size: .85rem; }
  textarea { resize: vertical; }
  pre { max-height: 26rem; overflow: auto; margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .status { margin: 0; }
  .status:empty { display: none; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1rem; }
  button { justify-self: start; cursor: pointer; }
  button:disabled { opacity: .6; cursor: wait; }
  @media (max-width: 560px) { .controls { grid-template-columns: 1fr; } }
</style>
