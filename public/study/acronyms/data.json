    {
      "id": "nine-line-medevac",
      "term": "9-Line MEDEVAC",
      "expansion": "Nine-line medical evacuation request",
      "category": "Casualty care",
      "meaning": "A standardized request that communicates essential information to arrange a medical evacuation.",
      "note": "The nine-line request and MIST serve different purposes. MIST summarizes clinical information for a casualty handoff.",
      "sourceIds": [
        "medevac-atp",
        "jts-transport"
      ],
      "prompt": "What information is included in a nine-line MEDEVAC request?",
      "components": [
        {
          "letter": "1",
          "meaning": "Location of pickup site"
        },
        {
          "letter": "2",
          "meaning": "Radio frequency, call sign, and suffix"
        },
        {
          "letter": "3",
          "meaning": "Number of patients by evacuation precedence"
        },
        {
          "letter": "4",
          "meaning": "Special equipment required"
        },
        {
          "letter": "5",
          "meaning": "Number of patients by type"
        },
        {
          "letter": "6",
          "meaning": "Pickup-site security (wartime) or number and type of wound, injury, or illness (peacetime)"
        },
        {
          "letter": "7",
          "meaning": "Method of marking the pickup site"
        },
        {
          "letter": "8",
          "meaning": "Patient nationality and status"
        },
        {
          "letter": "9",
          "meaning": "Chemical, biological, radiological, and nuclear (CBRN) contamination, when applicable (wartime), or terrain description (peacetime)"
        }
      ]
    },
