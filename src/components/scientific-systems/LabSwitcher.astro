---
interface Props { current: 'overview' | 'numerical' | 'symbolic'; }
const { current } = Astro.props;
const base = '/labs/scientific-systems/';
const items = [
  { id: 'overview', label: 'Overview', href: base },
  { id: 'numerical', label: 'Numerical', href: base + 'numerical/' },
  { id: 'symbolic', label: 'Symbolic', href: base + 'symbolic/' },
  { id: 'docs', label: 'Technical documentation', href: base + '#documentation' },
];
---
<nav class="lab-switcher" aria-label="Scientific Systems Lab">
  {items.map(({ id, label, href }) => (
    <a href={href} aria-current={current === id ? 'page' : undefined}>{label}</a>
  ))}
</nav>
<style>
  .lab-switcher {
    position:static; display:flex; flex-wrap:wrap; gap:.35rem .6rem;
    width:auto; max-height:none; overflow:visible; margin:0 0 1.5rem; padding:0;
    background:transparent; border:0;
  }
  .lab-switcher a { display:flex; align-items:center; min-height:44px; padding:.35rem .65rem; border:1px solid transparent; border-radius:5px; color:var(--text); font-size:.875rem; }
  .lab-switcher a:hover { text-decoration:underline; }
  .lab-switcher a[aria-current] { border-color:var(--border-strong); background:var(--bg-soft); font-weight:700; }
  .lab-switcher a:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
</style>
