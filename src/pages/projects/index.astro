---
import Base from '../../layouts/Base.astro';
import CollectionGlyph from '../../components/CollectionGlyph.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import WorkCard from '../../components/WorkCard.astro';
import { collections, registeredMemberIds, suiteCount, memberCount } from '../../data/collections';
import { visibleProjects } from '../../lib/projects';

// Draft walkthroughs appear only in local draft preview; registered apps are shown through their suites.
const drafts = (await visibleProjects()).filter(project => !registeredMemberIds.has(project.id));
---
<Base title="Work" description="Applications grouped into six collections and the suites that connect them: model engineering, agent systems, decision intelligence, scientific computing, business operations, and learning tools.">
  <div class="container work-page">
    <header class="work-intro">
      <p class="kicker">Work</p>
      <h1>{memberCount} applications, {suiteCount} suites, {collections.length} collections.</h1>
      <p>Each suite groups apps that belong together. Open any app to see how it works and what it actually computes.</p>
    </header>

    <div class="work-layout">
      <div class="work-rail" role="navigation" aria-label="Collections">
        <p class="work-rail__label">Collections</p>
        <ol>
          {collections.map(c => (
            <li data-collection={c.id}><a href={`#${c.id}`} data-rail={c.id}><span class="idx">{c.number}</span><span>{c.title}</span></a></li>
          ))}
        </ol>
      </div>

      <div class="work-content">
        {collections.map(c => (
          <section id={c.id} class="work-collection" data-collection={c.id} aria-labelledby={`${c.id}-title`}>
            <header class="work-collection__head">
              <div>
                <span class="work-collection__num">{c.number}</span>
                <h2 id={`${c.id}-title`}>{c.title}</h2>
                <p>{c.blurb}</p>
                {c.overview && <a class="arrow-link work-collection__overview" href={c.overview.href}>{c.overview.label} <span aria-hidden="true">→</span></a>}
              </div>
              <CollectionGlyph kind={c.glyph} />
            </header>
            <div class="work-collection__cards">
              {c.suites.map(suite => <WorkCard suite={suite} variant="full" />)}
            </div>
          </section>
        ))}

        {drafts.length > 0 && (
          <section class="work-drafts" aria-labelledby="drafts-title">
            <div class="section-head"><h2 id="drafts-title">Draft walkthroughs</h2></div>
            <div class="project-grid">{drafts.map(project => <ProjectCard project={project} />)}</div>
          </section>
        )}

        <section class="work-footer">
          <div class="section-head"><h2>Work in progress</h2></div>
          <p class="muted">Repositories and experiments that are not yet packaged as apps live in the activity tracker.</p>
          <a class="arrow-link" href="/activity/">GitHub and Hugging Face activity <span aria-hidden="true">→</span></a>
        </section>
      </div>
    </div>
  </div>
</Base>

<script>
  // Highlight the collection currently in view in the rail.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail]'));
  const sections = links.map(link => document.getElementById(link.dataset.rail || '')).filter((el): el is HTMLElement => !!el);
  const mark = (id: string) => links.forEach(link => {
    if (link.dataset.rail === id) link.setAttribute('aria-current', 'true'); else link.removeAttribute('aria-current');
  });
  if ('IntersectionObserver' in window && sections.length) {
    const observer = new IntersectionObserver(entries => {
      const visible = entries.filter(entry => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (visible) mark(visible.target.id);
    }, { rootMargin: '-20% 0px -65% 0px' });
    sections.forEach(section => observer.observe(section));
  }
</script>
