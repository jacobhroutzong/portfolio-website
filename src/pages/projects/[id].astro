---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PortfolioImage from '../../components/PortfolioImage.astro';
import Icon from '../../components/Icon.astro';
import { visibleProjects } from '../../lib/projects';
export async function getStaticPaths() { return (await visibleProjects()).map(project => ({ params: { id: project.id }, props: { project } })); }
const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
---
<Base title={p.title} description={p.summary} noindex={p.draft}><article class="container page-shell project-detail"><a class="text-link" href="/projects/">← All projects</a><div class="eyebrow detail-eyebrow">{p.category} / {p.status}{p.draft && ' / UNPUBLISHED DRAFT'}</div><h1 class="page-title">{p.title}</h1><p class="page-intro">{p.summary}</p>{p.draft && <div class="notice">Draft candidate. This is a planning document, not a claim of completed work or measured results.</div>}<div class="tags large">{p.technologies.map(t => <span>{t}</span>)}</div><div class="button-row">{p.sourceUrl && <a class="button secondary" href={p.sourceUrl} target="_blank" rel="noopener noreferrer">Source code <Icon name="github" size={18} /></a>}{p.demoUrl && <a class="button primary" href={p.demoUrl} target="_blank" rel="noopener noreferrer">Live demo <Icon name="external" size={17} /></a>}</div><div class="prose"><Content /></div>{p.screenshots.length > 0 && <section class="section"><h2>Screenshots & diagrams</h2><div class="gallery-grid">{p.screenshots.map(image => <figure><a href={image.src} target="_blank" rel="noopener noreferrer"><PortfolioImage src={image.src} alt={image.alt} /></a><figcaption>{image.example && <span class="badge">Illustrative example</span>}{image.caption}</figcaption></figure>)}</div></section>}{p.videos.length > 0 && <section class="section"><h2>Demonstrations</h2>{p.videos.map(video => <p><a class="text-link" href={video.url} target="_blank" rel="noopener noreferrer">{video.title} <Icon name="external" size={17} /></a></p>)}</section>}</article></Base>
