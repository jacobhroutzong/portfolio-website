---
// Decorative mark for a collection. Each one sketches the kind of thing the work does:
// a loss curve, a plan tree, a confidence gate, a matrix, stepped scenarios, a learning ladder.
interface Props { kind: 'curve' | 'tree' | 'gate' | 'matrix' | 'steps' | 'ladder'; class?: string; }
const { kind, class: className } = Astro.props;
const cells = [
  [1, 0, 0, 0.35],
  [0.35, 1, 0, 0],
  [0, 0.35, 1, 0],
  [0, 0, 0.35, 1],
];
---
<svg class:list={['glyph', className]} viewBox="0 0 96 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {kind === 'curve' && (<>
    <path d="M4 44h88" opacity=".35" />
    <path d="M4 8c16 2 22 26 44 29s34 3 44 3" />
    <circle cx="4" cy="8" r="2.2" fill="currentColor" stroke="none" />
    <circle cx="48" cy="37" r="2.2" fill="currentColor" stroke="none" />
    <circle cx="92" cy="40" r="2.2" fill="currentColor" stroke="none" />
  </>)}
  {kind === 'tree' && (<>
    <path d="M10 24h16m0 0c8 0 8-14 18-14h8m-26 14c8 0 8 14 18 14h8m-8-24c6 0 6-6 12-6m-12 6c6 0 6 6 12 6m-12 18c6 0 6-6 12-6m-12 6c6 0 6 6 12 6" />
    <circle cx="10" cy="24" r="3" fill="currentColor" stroke="none" />
    <circle cx="26" cy="24" r="2.2" fill="currentColor" stroke="none" />
    <circle cx="52" cy="10" r="2.2" fill="currentColor" stroke="none" />
    <circle cx="52" cy="38" r="2.2" fill="currentColor" stroke="none" />
    <circle cx="68" cy="4" r="1.8" /><circle cx="68" cy="16" r="1.8" /><circle cx="68" cy="32" r="1.8" /><circle cx="68" cy="44" r="1.8" />
  </>)}
  {kind === 'gate' && (<>
    <path d="M4 20h88" stroke-dasharray="3 4" opacity=".55" />
    <path d="M4 36l14-6 14 8 14-22 14 8 14-14 18 4" />
    <circle cx="60" cy="20" r="2.4" fill="currentColor" stroke="none" />
  </>)}
  {kind === 'matrix' && (<>
    {cells.map((row, r) => row.map((v, c) => (
      <rect x={16 + c * 17} y={3 + r * 11} width="13" height="8" rx="1.5" fill={v > 0 ? 'currentColor' : 'none'} fill-opacity={v} stroke={v === 0 ? 'currentColor' : 'none'} stroke-opacity={v === 0 ? 0.3 : 0} />
    )))}
  </>)}
  {kind === 'steps' && (<>
    <path d="M4 44h88" opacity=".35" />
    <rect x="10" y="30" width="14" height="14" rx="1.5" fill="currentColor" fill-opacity=".25" />
    <rect x="30" y="22" width="14" height="22" rx="1.5" fill="currentColor" fill-opacity=".45" />
    <rect x="50" y="14" width="14" height="30" rx="1.5" fill="currentColor" fill-opacity=".7" />
    <rect x="70" y="5" width="14" height="39" rx="1.5" fill="currentColor" />
  </>)}
  {kind === 'ladder' && (<>
    <path d="M4 42h22V32h22V22h22V12h22" />
    <path d="M4 46h88" opacity=".35" />
    <circle cx="92" cy="12" r="2.2" fill="currentColor" stroke="none" />
  </>)}
</svg>
<style>
  .glyph { width: 96px; height: 48px; color: var(--c, var(--accent)); flex-shrink: 0; }
</style>
